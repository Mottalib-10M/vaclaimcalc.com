---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const frames = [
  { slug: 'va-disability-calculator', title: 'VA disability calculator: combined rating and 2026 monthly amount', h: 1250, who: 'Veterans service organizations, county veterans service officers, transition assistance offices and base newspapers' },
  { slug: 'bah-calculator', title: 'BAH 2026 calculator by ZIP code', h: 900, who: 'Relocation offices, spouse clubs, installation housing pages and PCS checklists' },
];
const code = (f: (typeof frames)[number]) => `<iframe src="${SITE_URL}/embed/${f.slug}/" title="${f.title}" width="100%" height="${f.h}" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the VA disability or BAH calculator on your site" description="Free iframe of the VA disability calculator (combined rating, 2026 amount with dependents) or of the BAH 2026 lookup by ZIP code, updated each December and January." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed a calculator', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed a calculator' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="font-serif text-3xl font-bold text-navy-900 md:text-4xl">Embed a calculator</h1>
    <p class="mt-3 text-lg text-navy-700">One line of code. When VA applies the December cost-of-living adjustment and when DFAS and the DTMO publish the January tables, the embedded tool follows.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <p>Terms: keep the credit line under the frame visible, do not alter the frame, and present results as estimates, since VA and DFAS decide the actual payment. The frame sets no cookie and sends nothing about its users. Questions: <a href={route('contact', lang)}>contact page</a>.</p>
    {frames.map((f) => <><h2>{f.title}</h2><p>Useful for: {f.who}.</p><pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code(f)}</code></pre></>)}
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/va-disability-calculator/" title="VA disability calculator" width="100%" height="1250" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
