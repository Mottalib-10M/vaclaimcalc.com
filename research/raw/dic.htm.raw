"><a href="/" class="va-header-logo"><img alt="VA logo and Seal, U.S. Department of Veterans Affairs" loading="lazy" width="264" height="59" decoding="async" data-nimg="1" style="color:transparent" src="/img/header-logo.png"/></a></div><div class="tablet:vads-u-display--none vads-grid-container"><div class="menu-rule"></div><div class="mega-menu" id="mega-menu-mobile"></div></div><div id="login-root" class="vet-toolbar vads-u-margin-y--0p5"></div></div></div><div class="vads-grid-container vads-u-padding-x--0"><div class="vads-u-width--full vads-u-align-items--center"><div class="menu-rule vads-u-margin-x--0"></div></div><div class="mega-menu" id="mega-menu"></div></div></div><div data-widget-type="maintenance-banner" data-testid="maintenance-banner"></div></header><div data-widget-type="situation-updates-banner"></div><div class="vads-grid-container" style="min-height:5.125rem"><va-breadcrumbs class="vads-grid-row" wrapping="" breadcrumb-list="[{&quot;href&quot;:&quot;/&quot;,&quot;label&quot;:&quot;Home&quot;},{&quot;href&quot;:&quot;/family-and-caregiver-benefits&quot;,&quot;label&quot;:&quot;VA benefits for family and caregivers&quot;},{&quot;href&quot;:&quot;/family-and-caregiver-benefits/survivor-compensation&quot;,&quot;label&quot;:&quot;Survivors Pension and D.I.C.&quot;},{&quot;href&quot;:&quot;/family-and-caregiver-benefits/survivor-compensation/dependency-indemnity-compensation&quot;,&quot;label&quot;:&quot;About VA D.I.C. for spouses, dependents, and parents&quot;},{&quot;href&quot;:&quot;&quot;,&quot;label&quot;:&quot;Current D.I.C. rates for spouses and dependents&quot;}]"></va-breadcrumbs></div><main lang="en"><div id="content" class="interior"><div class="vads-grid-container va-l-detail-page"><div class="template-module__9NNqyG__gridRow va-sidebarnav-wrapper vads-grid-row vads-u-flex-wrap--nowrap"><nav data-template="navigation/sidebar_nav" aria-label="Secondary" id="va-detailpage-sidebar" data-drupal-sidebar="true" class="va-drupal-sidebarnav va-sidebarnav vads-grid-col-3 vads-u-margin-bottom--2"><div aria-modal="true" role="dialog" aria-labelledby="sidebar_header"><button class="va-sidenav-btn-close va-sidebarnav-close" type="button" aria-label="Close this menu"><va-icon icon="close" size="3" class="vads-u-color--gray-dark"></va-icon></button><div class="vads-u-display--flex vads-u-align-items--center left-side-nav-title"><va-icon icon="groups" size="3" class="hub-icon vads-u-color--white vads-u-display--flex vads-u-align-items--center vads-u-justify-content--center vads-u-margin-right--1 vads-u-background-color--hub-family-member"></va-icon><h4 id="sidebar_header">Family and caregiver benefits</h4></div><div class="sidenav-previous-page"><a href="/family-and-caregiver-benefits/survivor-compensation/dependency-indemnity-compensation">Dependency and Indemnity Compensation (D.I.C.)</a></div><ul class="usa-sidenav-list"><li class="active-level"><a class="usa-current" href="/family-and-caregiver-benefits/survivor-compensation/dependency-indemnity-compensation/survivor-rates">Spouse and dependent rates</a><ul class="usa-sidenav-sub_list"><li><a class="" href="/family-and-caregiver-benefits/survivor-compensation/dependency-indemnity-compensation/survivor-rates/past-rates-2025">Past rates: 2025</a></li><li><a class="" href="/family-and-caregiver-benefits/survivor-compensation/dependency-indemnity-compensation/survivor-rates/past-rates-2024">Past rates: 2024</a></li><li><a class="" href="/family-and-caregiver-benefits/survivor-compensation/dependency-indemnity-compensation/survivor-rates/past-rates-2023">Past rates: 2023</a></li></ul></li><li class=""><a class="" href="/family-and-caregiver-benefits/survivor-compensation/dependency-indemnity-compensation/parent-rates">Parent rates</a><ul class="usa-sidenav-sub_list"><li><a class="" href="/family-and-caregiver-benefits/survivor-compensation/dependency-indemnity-compensation/parent-rates/past-rates-2025">Past rates: 2025</a></li><li><a class="" href="/family-and-caregiver-benefits/survivor-compensation/dependency-indemnity-compensation/parent-rates/past-rates-2024">Past rates: 2024</a></li><li><a class="" href="/family-and-caregiver-benefits/survivor-compensation/dependency-indemnity-compensation/parent-rates/past-rates-2023">Past rates: 2023</a></li></ul></li><li class=""><a class="" href="https://www.va.gov/family-and-caregiver-benefits/survivor-compensation/dependency-indemnity-compensation/verify-marital-status-21p-0537/">Verify marital status for DIC benefits</a></li></ul></div></nav><div class="va-btn-sidebarnav-trigger"><div class="sidenav-trigger-sentinel"></div><div class="" id="sidenav-trigger"><button aria-controls="va-detailpage-sidebar"><strong>In this section</strong><va-icon icon="menu" size="3" class="vads-u-color--link-default"></va-icon></button></div></div><div class="vads-grid-row"><div class="vads-grid-col-12"><script type="application/ld+json">{"@context":"https://schema.org","@type":"WebPage","name":"Current D.I.C. rates for spouses and dependents","headline":"Current D.I.C. rates for spouses and dependents","description":"Review 2026 VA D.I.C. (Dependency and Indemnity Compensation) rates for the surviving spouses and dependent children of Veterans. These VA survivor benefits are tax exempt. This means you won’t have to pay any taxes on your D.I.C. payments.","url":"https://www.va.gov/family-and-caregiver-benefits/survivor-compensation/dependency-indemnity-compensation/survivor-rates/"}</script><article class="usa-content vads-u-padding-bottom--0"><div data-widget-type="i18-select"></div><h1>Current D.I.C. rates for spouses and dependents</h1><div class="va-introtext"><p>Review 2026 VA Dependency and Indemnity Compensation (D.I.C.) rates for the surviving spouses and dependent children of Veterans. These VA survivor benefits are tax exempt. This means you won’t have to pay any taxes on your compensation payments. These rates are effective December 1, 2025.</p>
</div><div data-testid="on-this-page"></div><div data-template="paragraphs/wysiwyg" data-paragraph-type="paragraph--wysiwyg"><div itemProp="text"><h2 id="surviving-spouse-rates-if-the-">Surviving spouse rates if the Veteran died on or after January 1, 1993</h2><h3>If you’re the surviving spouse of a Veteran</h3><p><strong>Your monthly payment rate is: $1,699.36</strong><br>Effective December 1, 2025</p><p>You may also be eligible for added amounts based on certain factors. Find any descriptions in the table that are true for you. Add the amount listed in the <strong>Added monthly amount</strong> column of each description to your monthly payment. This is your total monthly payment.</p><h4>Added amounts for surviving spouses</h4><p>Effective December 1, 2025</p></div></div><va-table table-title="" table-type="bordered"><va-table-row slot="headers"><span>If this description is true…</span><span>You may qualify for this benefit</span><span>Added monthly amount (in&nbsp;U.S.&nbsp;$)</span></va-table-row><va-table-row slot=""><span><ul><li>The Veteran had a VA disability rating of totally disabling (including for individual unemployability) for at least the 8 full years leading up to their death, <b>and</b></li><li>You were married to the Veteran for those same 8 years</li></ul></span><span>8-year provision</span><span>360.85</span></va-table-row><va-table-row slot=""><span>You have a disability and need help with regular daily activities (like eating, bathing, or dressing)</span><span>Aid and Attendance</span><span>421.00</span></va-table-row><va-table-row slot=""><span>You can’t leave your house due to a disability</span><span>Housebound allowance</span><span>197.22</span></va-table-row><va-table-row slot=""><span>You have 1 or more children who are under 18</span><span><ul><li>Transitional benefit, <b>and</b></li><li>D.I.C. apportionment rate</li></ul></span><span><ul><li>359.00 for the first 2 years after the Veteran’s death</li><li>421.00  for each eligible child</li></ul></span></va-table-row></va-table><div data-template="paragraphs/wysiwyg" data-paragraph-type="paragraph--wysiwyg"><div itemProp="text"><h4>Example of how to calculate your payment</h4><p>If you’re the surviving spouse of a Veteran, your monthly rate would start at <strong>$1,699.36</strong>.</p><p>Then for each additional benefit you qualify for, you would add the amounts from the <strong>Added amounts</strong> table.</p><p><strong>In this example:</strong> We show the total monthly payment for someone with 2 children under 18, and who qualifies for the 8-year provision and Aid and Attendance.</p><p><strong>Total monthly payment for the first 2 years:</strong></p><p>&nbsp;$1,699.36&nbsp;(monthly rate)<br>+ $421.00 (first child under 18)<br>+ $421.00&nbsp;(second child under 18)<br>+ $360.85&nbsp;(8-year provision)<br>+ $421.00&nbsp;(Aid and Attendance)<br>+ $359.00 (transitional benefit for the first 2 years after the Veteran’s death)<br><strong>= $3,682.21 per month</strong></p><p><strong>Total monthly payment after 2 years (when transitional benefit ends):</strong></p><p>$3,682.21 (monthly payment with transitional benefit)<br>- $359.00 (transitional benefit)<br><strong>= $3,323.21 per month</strong></p></div></div><div data-template="paragraphs/wysiwyg" data-paragraph-type="paragraph--wysiwyg"><div itemProp="text"><p><strong>Note:</strong> You can find the details of these rates in title 38 U.S.C. 1311(a, b, c, d, f) and 38 CFR 3.461(b).</p><hr><h2 id="surviving-spouse-rates-if-the-">Surviving spouse&nbsp;rates if the Veteran died before January 1, 1993</h2><p>If you’re the spouse or child of a Veteran who died before January 1, 1993, we use a different method to determine your monthly payment.</p><h3>Surviving spouse, with or without dependent children</h3><p>To find your monthly payment, select your Veteran’s pay grade category. Find their specific pay grade in the left column of the <strong>Monthly payment rates</strong> table, and the matching monthly payment to the right.</p><p>Then, go to the <strong>Added or increased amounts </strong>table. Add any added or increased amounts that apply to you based on the Veteran’s disability rating and whether you have dependent children under 18.</p></div></div><div id="a9395cfd-a348-4c7a-b842-7a57e8b123cc" data-template="paragraphs/collapsible_panel" data-paragraph-type="paragraph--collapsible_panel" data-entity-id="187452"><va-accordion><va-accordion-item class="va-accordion-item" id="enlisted-veteran-pay-grades-e-1-to-e-9-2ee17376-63a4-41b9-9df3-08e78e737797"><h4 slot="headline">Enlisted Veteran pay grades E-1 to E-9</h4><div id="2ee17376-63a4-41b9-9df3-08e78e737797" data-template="paragraphs/collapsible_panel__panel" data-paragraph-type="paragraph--collapsible_panel_item" data-entity-id="191836" data-analytics-faq-text="Enlisted Veteran pay grades E-1 to E-9"><div id="collapsible_panel_item-191836"><div itemProp="text"><h4>Monthly payment rates</h4><p>Effective December 1, 2025</p><p><strong>Note:</strong> If you’re the surviving spouse of an aviation cadet or other service member not covered by this table, you’ll receive the rate for enlisted E-3.</p></div><va-table table-title="" table-type="bordered"><va-table-row slot="headers"><span>Veteran’s pay grade</span><span>Monthly payment (in&nbsp;U.S.&nbsp;$)</span></va-table-row><va-table-row slot=""><span><b>E-1, E-2, E-3, E-4, E-5, E-6</b></span><span>1,699.36</span></va-table-row><va-table-row slot=""><span><b>E-7</b></span><span>1,758.09</span></va-table-row><va-table-row slot=""><span><b>E-8</b></span><span>1,856.02</span></va-table-row><va-table-row slot=""><span><b>E-9 regular</b></span><span>1,935.72</span></va-table-row><va-table-row slot=""><span><b>E-9 special capacity</b><br>Veteran served as: <ul><li>Sergeant Major of the Army or Marine Corps, <b>or</b></li><li>Senior enlisted adviser of the Navy, <b>or</b></li><li>Chief Master Sergeant of the Air Force, <b>or</b></li><li>Master Chief Petty Officer of the Coast Guard</li></ul></span><span>2,089.58</span></va-table-row></va-table><va-table table-title="Added or increased amounts" table-type="bordered"><va-table-row slot="headers"><span>If this description is true…</span><span>We’ll adjust your monthly payment by this amount (in&nbsp;U.S.&nbsp;$)</span></va-table-row><va-table-row slot=""><span><ul><li>The Veteran had a pay grade of <b>E-1 to E-7</b>, <b>and</b></li><li>The Veteran had a VA disability rating of totally disabling (including for individual unemployability) for at least the 8 full years leading up to their death, <b>and</b></li><li>You were married to the Veteran for those same 8 years</li></ul></span><span>Add $360.85</span></va-table-row><va-table-row slot=""><span><ul><li>The Veteran had a pay grade of <b>E-8 or E-9</b>, <b>and</b></li><li>The Veteran had a VA disability rating of totally disabling for at least the 8 full years leading up to their death, <b>and</b></li><li>You were married to the Veteran for those same 8 years</li></ul></span><span>Increase payment to $2,060.20</span></va-table-row><va-table-row slot=""><span>You have 1 or more children who are under 18</span><span>Add $421.00 per child</span></va-table-row></va-table></div></div></va-accordion-item><va-accordion-item class="va-accordion-item" id="warrant-officer-pay-grades-w-1-to-w-4-b09e3dfd-cca5-496e-a254-254c97223ab1"><h4 slot="headline">Warrant officer pay grades W-1 to W-4</h4><div id="b09e3dfd-cca5-496e-a254-254c97223ab1" data-template="paragraphs/collapsible_panel__panel" data-paragraph-type="paragraph--collapsible_panel_item" data-entity-id="191842" data-analytics-faq-text="Warrant officer pay grades W-1 to W-4"><div id="collapsible_panel_item-191842"><va-table table-title="Monthly payment rates" table-type="bordered"><va-table-row slot="headers"><span>Veteran’s pay grade</span><span>Monthly payment (in&nbsp;U.S.&nbsp;$)</span></va-table-row><va-table-row slot=""><span><b>W-1</b></span><span>1,794.49</span></va-table-row><va-table-row slot=""><span><b>W-2</b></span><span>1,865.80</span></va-table-row><va-table-row slot=""><span><b>W-3</b></span><span>1,920.33</span></va-table-row><va-table-row slot=""><span><b>W-4</b></span><span>2,032.23</span></va-table-row></va-table><va-table table-title="Added or increased amounts" table-type="bordered"><va-table-row slot="headers"><span>If this description is true…</span><span>We’ll adjust your monthly payment by this amount (in&nbsp;U.S.&nbsp;$)</span></va-table-row><va-table-row slot=""><span><ul><li>The Veteran had a VA disability rating of totally disabling (including for individual unemployability) for at least the 8 full years leading up to their death, <b>and</b></li><li>You were married to the Veteran for those same 8 years</li></ul></span><span>Increase payment to $2,060.20</span></va-table-row><va-table-row slot=""><span>You have 1 or more children who are under 18</span><span>Add $421.00 per child</span></va-table-row></va-table></div></div></va-accordion-item><va-accordion-item class="va-accordion-item" id="officer-pay-grades-o-1-to-o-10-ef263930-bab7-4db0-b39d-015040405b90"><h4 slot="headline">Officer pay grades O-1 to O-10</h4><div id="ef263930-bab7-4db0-b39d-015040405b90" data-template="paragraphs/collapsible_panel__panel" data-paragraph-type="paragraph--collapsible_panel_item" data-entity-id="191848" data-analytics-faq-text="Officer pay grades O-1 to O-10"><div id="collapsible_panel_item-191848"><va-table table-title="Monthly payment rates" table-type="bordered"><va-table-row slot="headers"><span>Veteran’s pay grade</span><span>Monthly payment (in&nbsp;U.S.&nbsp;$)</span></va-table-row><va-table-row slot=""><span><b>O-1</b></span><span>1,794.49</span></va-table-row><va-table-row slot=""><span><b>O-2</b></span><span>1,856.02</span></va-table-row><va-table-row slot=""><span><b>O-3</b></span><span>1,983.26</span></va-table-row><va-table-row slot=""><span><b>O-4</b></span><span>2,102.15</span></va-table-row><va-table-row slot=""><span><b>O-5</b></span><span>2,313.37</span></va-table-row><va-table-row slot=""><span><b>O-6</b></span><span>2,608.49</span></va-table-row><va-table-row slot=""><span><b>O-7</b></span><span>2,815.45</span></va-table-row><va-table-row slot=""><span><b>O-8</b></span><span>3,092.41</span></va-table-row><va-table-row slot=""><span><b>O-9</b></span><span>3,307.79</span></va-table-row><va-table-row slot=""><span><b>O-10 regular</b></span><span>3,628.08</span></va-table-row><va-table-row slot=""><span><b>O-10 special capacity </b><br>Veteran served as:<ul><li>Chairman of the Joint Chiefs of Staff, <b>or</b></li><li>Chief of Staff of the Army or Air Force, <b>or</b></li><li>Chief of Naval Operations, <b>or</b></li><li>Commandant of the Marine Corps</li></ul></span><span>3,893.83</span></va-table-row></va-table><va-table table-title="Added or increased amounts" table-type="bordered"><va-table-row slot="headers"><span>If this description is true…</span><span>We’ll adjust your monthly payment by this amount (in&nbsp;U.S.&nbsp;$)</span></va-table-row><va-table-row slot=""><span><ul><li>The Veteran had a pay grade of O-1 to O-3, <b>and</b></li><li>The Veteran had a VA service-connected disability rating of totally disabling (including for individual unemployability) for at least the 8 full years leading up to their death, <b>and</b></li><li>You were married to the Veteran for those same 8 years</li></ul></span><span>Increase payment to $2,060.20</span></va-table-row><va-table-row slot=""><span>You have 1 or more children who are under 18</span><span>Add $421.00 per child</span></va-table-row></va-table></div></div></va-accordion-item></va-accordion></div><div data-template="paragraphs/wysiwyg" data-paragraph-type="paragraph--wysiwyg"><div itemProp="text"><h4>Example&nbsp;of how to calculate your monthly payment</h4><p>If you’re the surviving spouse of a Veteran whose pay grade was E-3, your monthly rate would start at <strong>$1,699.36</strong>.</p><p>Then for each additional benefit you qualify for, you would add or adjust your monthly rate using the <strong>Added or increased amounts</strong> table.</p><p><strong>In this example:</strong> We show the total monthly payment for someone with the E-3 monthly rate who qualifies for the 8-year provision and has 2 children under 18.</p><p>$1,699.36 (monthly rate)<br>+ $360.85&nbsp;(8-year provision for E-3 pay grade)<br>+ $421.00&nbsp;(rate for first child under age 18)<br>+ $421.00&nbsp;(rate for second child under age 18)<br>= <strong>$2,902.21 total monthly payment</strong></p><p>If you were the surviving spouse of a Veteran whose pay grade was<strong> E-9</strong>, <strong>and</strong> you qualified for the 8-year provision, <strong>and</strong> you had 2 dependent children under 18, you would calculate your monthly payment as in this example:</p><p>$2,060.21 (increased payment for Veteran with pay grade of E-8 or E-9, with 8-year provision)<br>+ $421.00&nbsp;(rate for first child under 18)<br>+ $421.00 (rate for second child under 18)<br><strong>= $2,902.21 total monthly payment</strong></p></div></div><div data-template="paragraphs/wysiwyg" data-paragraph-type="paragraph--wysiwyg"><div itemProp="text"><hr><h2 id="monthly-rates-if-youre-the-sur">Monthly rates if you’re the surviving child of a Veteran</h2><p>Find the survivor status that applies to you.</p><h3>Surviving, unmarried adult child of a Veteran, when the Veteran’s surviving spouse is also eligible for Dependency and Indemnity Compensation</h3><p>We make this monthly payment to you separately as the adult surviving child, in addition to the eligible surviving spouse’s compensation.</p><h4>Monthly payment rates</h4><p>Effective December 1, 2025</p></div></div><va-table table-title="" table-type="bordered"><va-table-row slot="headers"><span>Child status</span><span>Monthly payment (in&nbsp;U.S.&nbsp;$)</span></va-table-row><va-table-row slot=""><span>Child between 18 and 23 who’s in a qualified school program</span><span>356.66</span></va-table-row><va-table-row slot=""><span>Helpless child over 18 <br>(An adult child who became permanently unable to support themselves before age 18)</span><span>717.50</span></va-table-row></va-table><div data-template="paragraphs/wysiwyg" data-paragraph-type="paragraph--wysiwyg"><div itemProp="text"><h3>Surviving eligible child of a Veteran, when the Veteran doesn’t have a surviving spouse who’s eligible for Dependency and Indemnity Compensation</h3><p>We’ll base your payment amount on the number of the Veteran’s eligible surviving children. You’re an eligible child&nbsp;if you meet&nbsp;at least 1 of these requirements.</p><p><strong>At least 1 of these must be true:</strong></p><ul><li>You’re under 18, <strong>or</strong></li><li>You’re between 18 and 23 and in a VA-approved school program, <strong>or</strong></li><li>You’re permanently unable to support yourself due to a disability that happened before age 18 (we use the term&nbsp;“helpless child”)</li></ul><h4>Monthly payment rates</h4><p>Effective December 1, 2025</p></div></div><va-table table-title="" table-type="bordered"><va-table-row slot="headers"><span>Number of Veteran’s eligible children</span><span>Monthly rate for each child (in&nbsp;U.S.&nbsp;$)</span><span>Total monthly payment (in&nbsp;U.S.&nbsp;$)</span></va-table-row><va-table-row slot=""><span><b>1</b></span><span>717.50</span><span>717.50</span></va-table-row><va-table-row slot=""><span><b>2</b></span><span>516.09</span><span>1,032.18</span></va-table-row><va-table-row slot=""><span><b>3</b></span><span>448.97</span><span>1,346.92</span></va-table-row><va-table-row slot=""><span><b>4</b></span><span>400.72</span><span>1,602.87</span></va-table-row><va-table-row slot=""><span><b>5</b></span><span>371.76</span><span>1,858.82</span></va-table-row><va-table-row slot=""><span><b>6</b></span><span>352.46</span><span>2,114.77</span></va-table-row><va-table-row slot=""><span><b>7</b></span><span>338.67</span><span>2,370.72</span></va-table-row><va-table-row slot=""><span><b>8</b></span><span>328.33</span><span>2,626.67</span></va-table-row><va-table-row slot=""><span><b>9</b></span><span>320.29</span><span>2,882.62</span></va-table-row></va-table><div data-template="paragraphs/wysiwyg" data-paragraph-type="paragraph--wysiwyg"><div itemProp="text"><h4>Added amounts</h4><ul><li>For each additional eligible child in a family of 10 or more children, add $255.95.</li><li>For each helpless child over 18, add $421 to your monthly rate above. This will be your&nbsp;total monthly payment. For example, if there are 2&nbsp;eligible surviving children, and 1 of them is a helpless child, the rate for that child would be $937.09 ($516.09&nbsp;+ $421).</li></ul></div></div><div data-template="paragraphs/wysiwyg" data-paragraph-type="paragraph--wysiwyg"><div itemProp="text"><hr><h2 id="how-dependency-and-indemnity-c">How Dependency and Indemnity Compensation may affect your VA Survivors Pension or Survivor Benefit Plan</h2><h3>How do my payments for Dependency and Indemnity Compensation affect my ability to receive VA Survivors Pension?</h3><p>If you’re eligible for both Dependency and Indemnity Compensation and Survivors Pension benefits, we’ll pay you whichever benefit gives you the most money. You can’t get both.</p><p><a href="/family-and-caregiver-benefits/survivor-compensation/survivors-pension" data-entity-type="node" data-entity-uuid="3cab46c4-e831-431f-9155-baae533fd949" data-entity-substitution="canonical" title="Survivors Pension">Learn more about Survivors Pension benefits</a></p><p><a href="/family-and-caregiver-benefits/survivor-compensation/survivors-pension/rates" data-entity-type="node" data-entity-uuid="6b525ed4-168d-4f45-a62d-474d7174b4fa" data-entity-substitution="canonical" title="Current Survivors Pension benefit rates">Check current VA Survivors Pension benefit rates</a></p><h3>What’s a Survivor Benefit Plan?</h3><p>The Survivor Benefit Program is a voluntary annuity program that service members may buy as a retirement benefit for their family members. An annuity is a monthly payment received for life. Depending on their military service, members may use this program to buy a Survivor Benefit Plan (SBP) or Reserve Component Survivor Benefit Plan (RCSBP).</p><p>We don’t manage this program. It’s managed by the Defense Finance and Accounting Service (DFAS) at the Defense Department.</p><p>If you have questions about your SBP or RCSBP payments, you can call DFAS at <va-telephone contact="800-321-1080" extension=""></va-telephone>&nbsp;(TTY: 711).&nbsp;They’re open Monday through Friday,&nbsp;8:00 a.m. to 5:00 p.m. ET.</p><h3>Can I get SBP or RCSBP payments and Dependency and Indemnity Compensation at the same time?</h3><p>Yes. You can get a full SBP or RCSBP payment and a full Dependency and Indemnity Compensation payment at the same time.</p><p><strong>Note:</strong> In the past, DFAS reduced your SBP or RCSBP payments by a percentage of your Dependency and Indemnity Compensation payment. This was called the “SBP-D.I.C. Offset.” Starting on January 1, 2021, DFAS began reducing the offset in phases. On January 1, 2023, DFAS fully eliminated the offset. Survivors can now get full benefits for both programs.</p><p><a href="https://www.dfas.mil/RetiredMilitary/survivors/SBP-DIC-News/">Learn more about the end of the SBP-D.I.C. Offset on the DFAS website</a></p><hr><h2 id="past-rates">Past rates</h2><p>Review surviving spouse and child rates for Dependency and Indemnity Compensation for past years.</p><p><a href="/family-and-caregiver-benefits/survivor-compensation/dependency-indemnity-compensation/survivor-rates/past-rates-2025" data-entity-type="node" data-entity-uuid="aa269010-b004-4a89-a5e7-05524201bc8e" data-entity-substitution="canonical" title="Past rates: 2025 D.I.C. rates for spouses and dependents">2025 rates</a> (effective December 1, 2024)<br><a href="/family-and-caregiver-benefits/survivor-compensation/dependency-indemnity-compensation/survivor-rates/past-rates-2024" data-entity-type="node" data-entity-uuid="448a27a3-5e78-46f8-8e04-c28a1a1ce5f2" data-entity-substitution="canonical" title="Past rates: 2024 D.I.C. rates for spouses and dependents">2024 rates</a> (effective December 1, 2023)<br><a href="/family-and-caregiver-benefits/survivor-compensation/dependency-indemnity-compensation/survivor-rates/past-rates-2023" data-entity-type="node" data-entity-uuid="d552460e-f9be-4057-8af6-2a2551a9a567" data-entity-substitution="canonical" title="Past rates: 2023 D.I.C. rates for spouses and dependents">2023 rates</a> (effective December 1, 2022)</p><h2 id="full-title-38-regulations">Full Title 38 regulations</h2><p>Read the full regulations from Title 38 Code of Federal Regulations.</p><h3>Full section</h3><p><a href="https://www.govinfo.gov/app/details/USCODE-2011-title38/USCODE-2011-title38-partII-chap13-subchapII">38 U.S.C. II Dependency and Indemnity Compensation (chapter 13, sections 1310 to 1318)</a><br><a href="https://www.ecfr.gov/current/title-38/chapter-I/part-3#sp38.1.3.a">38 U.S.C. 501(a) Subpart A—Pension, Compensation, and Dependency and Indemnity Compensation</a></p><h3>Details related to rates for surviving spouses and children</h3><p><a href="https://www.ecfr.gov/current/title-38/chapter-I/part-3#se38.1.3_15">3.5 Dependency and indemnity compensation</a><br><a href="https://www.ecfr.gov/current/title-38/chapter-I/part-3#se38.1.3_110">3.10 Dependency and indemnity compensation rate for a surviving spouse</a><br><a href="https://www.ecfr.gov/current/title-38/chapter-I/part-3#se38.1.3_122">3.22 D.I.C. benefits for survivors of certain Veterans rated totally disabled at time of death</a></p></div></div><div class="va-nav-linkslist va-nav-linkslist--related"><section data-template="paragraphs/list_of_link_teasers" data-entity-id="98d2f9ad-08a2-45f3-8c6a-8c4a3c5b9144"><h2 id="other-information-you-may-need" class="vads-u-border-bottom--1px vads-u-border-color--base-light vads-u-margin--0 vads-u-padding-top--2 vads-u-padding-bottom--0p5">Other information you may need</h2><ul class="usa-unstyled-list"><li class="vads-u-margin-y--2" data-template="paragraphs/linkTeaser" data-entity-id="70f22f7b-1065-402a-99ce-037fdd82a8ce" data-links-list-header="VA Survivors Pension" data-links-list-section-header="Other information you may need"><p class="vads-u-margin--0 vads-u-font-weight--bold"><va-link href="/family-and-caregiver-benefits/survivor-compensation/survivors-pension/" target="" text="VA Survivors Pension"></va-link></p><p class="vads-u-margin--0">If you’re the surviving spouse or child of a Veteran with wartime service, find out if you’re eligible for monthly pension benefits based on your income and net worth.</p></li><li class="vads-u-margin-y--2" data-template="paragraphs/linkTeaser" data-entity-id="832a3dec-249f-438b-bcc2-49a8d55a37a0" data-links-list-header="Healthcare for spouses, dependents, and family caregivers" data-links-list-section-header="Other information you may need"><p class="vads-u-margin--0 vads-u-font-weight--bold"><va-link href="/family-and-caregiver-benefits/health-and-disability/" target="" text="Healthcare for spouses, dependents, and family caregivers"></va-link></p><p class="vads-u-margin--0">Find out if you may qualify for healthcare benefits through a program such as CHAMPVA or the Defense Department’s TRICARE program.</p></li><li class="vads-u-margin-y--2" data-template="paragraphs/linkTeaser" data-entity-id="0670274e-ff8b-43e0-b835-d7a275e20aad" data-links-list-header="VA education benefits for survivors and dependents" data-links-list-section-header="Other information you may need"><p class="vads-u-margin--0 vads-u-font-weight--bold"><va-link href="/family-and-caregiver-benefits/education-and-careers/" target="" text="VA education benefits for survivors and dependents"></va-link></p><p class="vads-u-margin--0">Find out if you may be eligible for education benefits or job training through a GI Bill program.</p></li><li class="vads-u-margin-y--2" data-template="paragraphs/linkTeaser" data-entity-id="8c26d845-f7db-40a3-b4db-4f50b9be244b" data-links-list-header="Family member benefits" data-links-list-section-header="Other information you may need"><p class="vads-u-margin--0 vads-u-font-weight--bold"><va-link href="/family-and-caregiver-benefits/" target="" text="Family member benefits"></va-link></p><p class="vads-u-margin--0">Learn how to apply for and manage other benefits available to the family members of Veterans and service members.</p></li><li class="vads-u-margin-y--2" data-template="paragraphs/linkTeaser" data-entity-id="84d50e9a-8bc9-421c-8cd5-89a2c526fe26" data-links-list-header="Past rates for surviving spouses and dependents on KnowVA" data-links-list-section-header="Other information you may need"><p class="vads-u-margin--0 vads-u-font-weight--bold"><va-link href="https://www.knowva.ebenefits.va.gov/system/templates/selfservice/va_ssnew/help/customer/locale/en-US/portal/554400000001018/content/554400000016337/Dependency-and-Indemnity-Compensation-Widowers-and-Children" target="" text="Past rates for surviving spouses and dependents on KnowVA"></va-link></p><p class="vads-u-margin--0">Find past rates (back to 1977) on the KnowVA website.</p></li></ul></section></div><va-back-to-top></va-back-to-top><div data-testid="content-footer" class="last-updated "><div class="mobile-lg:vads-u-display--flex above-footer-elements-container"><div class="vads-u-flex--auto"><span class="vads-u-text-align--justify"><p>Last updated: <time dateTime="2026-09-22">September 22, 2026</time></p></span></div><div class="vads-u-flex--1 vads-u-text-align--right"><va-button id="mdFormButton" disable-analytics="" secondary="" class="vads-u-background-color--white" text="Feedback"></va-button></div></div></div></article></div></div></div></div></div></main><footer class="footer"><div id="footerNav" data-testid="footer" data-minimal-footer="false"></div></footer><div id="logout-modal-root"></div></div><script id="__NEXT_DATA__" type="application/json" nonce="1sjTItZVxy9ajFhOuwgx3kIFvUPWOTKb">{"props":{"pageProps":{"previewTokenError":false,"preview":false,"serializedResource":{"data":{"id":"f7b6246e-81bb-4e02-886b-122619dc6165","entityId":73231,"entityPath":"/family-and-caregiver-benefits/survivor-compensation/dependency-indemnity-compensation/survivor-rates","type":"node--page","published":true,"moderationState":"published","title":"Current D.I.C. rates for spouses and dependents","metatags":[{"tag":"meta","attributes":{"name":"title","content":"Current D.I.C. rates for spouses and dependents | Veterans Affairs"}},{"tag":"meta","attributes":{"name":"description","content":"Review 2026 VA Dependency and Indemnity Compensation (D.I.C.) rates for the surviving spouses and dependent children of Veterans. These VA survivor benefits are tax exempt. This means you won’t have to pay any taxes on your compensation payments. These rates are effective December 1, 2025."}},{"tag":"link","attributes":{"rel":"image_src","href":"https://www.va.gov/img/design/logo/va-og-image.png"}},{"tag":"meta","attributes":{"property":"og:site_name","content":"Veterans Affairs"}},{"tag":"meta","attributes":{"property":"og:title","content":"Current D.I.C. rates for spouses and dependents | Veterans Affairs"}},{"tag":"meta","attributes":{"property":"og:description","content":"Review 2026 VA Dependency and Indemnity Compensation (D.I.C.) rates for the surviving spouses and dependent children of Veterans. These VA survivor benefits are tax exempt. This means you won’t have to pay any taxes on your compensation payments. These rates are effective December 1, 2025."}},{"tag":"meta","attributes":{"property":"og:image","content":"https://www.va.gov/img/design/logo/va-og-image.png"}},{"tag":"meta","attributes":{"property":"og:image:alt","content":"U.S. Department of Veterans Affairs"}},{"tag":"meta","attributes":{"name":"twitter:card","content":"summary_large_image"}},{"tag":"meta","attributes":{"name":"twitter:description","content":"Review 2026 VA D.I.C. (Dependency and Indemnity Compensation) rates for the surviving spouses and dependent children of Veterans. These VA survivor benefits are tax exempt. This means you won’t have to pay any taxes on your D.I.C. payments."}},{"tag":"meta","attributes":{"name":"twitter:site","content":"@DeptVetAffairs"}},{"tag":"meta","attributes":{"name":"twitter:title","content":"Current D.I.C. rates for spouses and dependents | Veterans Affairs"}},{"tag":"meta","attributes":{"name":"twitter:image","content":"https://www.va.gov/img/design/logo/va-og-image.png"}},{"tag":"meta","attributes":{"name":"twitter:image:alt","content":"U.S. Department of Veterans Affairs"}}],"breadcrumbs":[{"href":"/","label":"Home"},{"href":"/family-and-caregiver-benefits","label":"VA benefits for family and caregivers"},{"href":"/family-and-caregiver-benefits/survivor-compensation","label":"Survivors Pension and D.I.C."},{"href":"/family-and-caregiver-benefits/survivor-compensation/dependency-indemnity-compensation","label":"About VA D.I.C. for spouses, dependents, and parents"},{"href":"","label":"Current D.I.C. rates for spouses and dependents"}],"lastUpdated":"2026-09-22T16:40:10+00:00","description":"Review 2026 VA D.I.C. (Dependency and Indemnity Compensation) rates for the surviving spouses and dependent children of Veterans. These VA survivor benefits are tax exempt. This means you won’t have to pay any taxes on your D.I.C. payments.","introText":"\u003cp\u003eReview 2026 VA Dependency and Indemnity Compensation (D.I.C.) rates for the surviving spouses and dependent children of Veterans. These VA survivor benefits are tax exempt. This means you won’t have to pay any taxes on your compensation payments. These rates are effective December 1, 2025.\u003c/p\u003e\n","showTableOfContents":true,"alert":null,"featuredContent":[],"mainContent":[{"type":"paragraph--wysiwyg","id":"3b912d5a-817d-4c1f-af47-6bab6306152c","html":"\u003ch2 id=\"surviving-spouse-rates-if-the-\"\u003eSurviving spouse rates if the Veteran died on or after January 1, 1993\u003c/h2\u003e\u003ch3\u003eIf you’re the surviving spouse of a Veteran\u003c/h3\u003e\u003cp\u003e\u003cstrong\u003eYour monthly payment rate is: $1,699.36\u003c/strong\u003e\u003cbr\u003eEffective December 1, 2025\u003c/p\u003e\u003cp\u003eYou may also be eligible for added amounts based on certain factors. Find any descriptions in the table that are true for you. Add the amount listed in the \u003cstrong\u003eAdded monthly amount\u003c/strong\u003e column of each description to your monthly payment. This is your total monthly payment.\u003c/p\u003e\u003ch4\u003eAdded amounts for surviving spouses\u003c/h4\u003e\u003cp\u003eEffective December 1, 2025\u003c/p\u003e"},{"type":"paragraph--table","id":"be9e4d41-f435-4f1a-b30d-4eb1ab08c65d","entityId":187434,"title":"","data":[["If this description is true…","You may qualify for this benefit","Added monthly amount (in\u0026nbsp;U.S.\u0026nbsp;$)"],["\u003cul\u003e\u003cli\u003eThe Veteran had a VA disability rating of totally disabling (including for individual unemployability) for at least the 8 full years leading up to their death, \u003cb\u003eand\u003c/b\u003e\u003c/li\u003e\u003cli\u003eYou were married to the Veteran for those same 8 years\u003c/li\u003e\u003c/ul\u003e","8-year provision","360.85"],["You have a disability and need help with regular daily activities (like eating, bathing, or dressing)","Aid and Attendance","421.00"],["You can’t leave your house due to a disability","Housebound allowance","197.22"],["You have 1 or more children who are under 18","\u003cul\u003e\u003cli\u003eTransitional benefit, \u003cb\u003eand\u003c/b\u003e\u003c/li\u003e\u003cli\u003eD.I.C. apportionment rate\u003c/li\u003e\u003c/ul\u003e","\u003cul\u003e\u003cli\u003e359.00 for the first 2 years after the Veteran’s death\u003c/li\u003e\u003cli\u003e421.00  for each eligible child\u003c/li\u003e\u003c/ul\u003e"]]},{"type":"paragraph--wysiwyg","id":"4f79bb3d-4460-43a2-8ee8-6a7f11673852","html":"\u003ch4\u003eExample of how to calculate your payment\u003c/h4\u003e\u003cp\u003eIf you’re the surviving spouse of a Veteran, your monthly rate would start at \u003cstrong\u003e$1,699.36\u003c/strong\u003e.\u003c/p\u003e\u003cp\u003eThen for each additional benefit you qualify for, you would add the amounts from the \u003cstrong\u003eAdded amounts\u003c/strong\u003e table.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eIn this example:\u003c/strong\u003e We show the total monthly payment for someone with 2 children under 18, and who qualifies for the 8-year provision and Aid and Attendance.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eTotal monthly payment for the first 2 years:\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u0026nbsp;$1,699.36\u0026nbsp;(monthly rate)\u003cbr\u003e+ $421.00 (first child under 18)\u003cbr\u003e+ $421.00\u0026nbsp;(second child under 18)\u003cbr\u003e+ $360.85\u0026nbsp;(8-year provision)\u003cbr\u003e+ $421.00\u0026nbsp;(Aid and Attendance)\u003cbr\u003e+ $359.00 (transitional benefit for the first 2 years after the Veteran’s death)\u003cbr\u003e\u003cstrong\u003e= $3,682.21 per month\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eTotal monthly payment after 2 years (when transitional benefit ends):\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e$3,682.21 (monthly payment with transitional benefit)\u003cbr\u003e- $359.00 (transitional benefit)\u003cbr\u003e\u003cstrong\u003e= $3,323.21 per month\u003c/strong\u003e\u003c/p\u003e"},{"type":"paragraph--wysiwyg","id":"15b9c19d-2344-4e2c-a582-06c271c0bf0b","html":"\u003cp\u003e\u003cstrong\u003eNote:\u003c/strong\u003e You can find the details of these rates in title 38 U.S.C. 1311(a, b, c, d, f) and 38 CFR 3.461(b).\u003c/p\u003e\u003chr\u003e\u003ch2 id=\"surviving-spouse-rates-if-the-\"\u003eSurviving spouse\u0026nbsp;rates if the Veteran died before January 1, 1993\u003c/h2\u003e\u003cp\u003eIf you’re the spouse or child of a Veteran who died before January 1, 1993, we use a different method to determine your monthly payment.\u003c/p\u003e\u003ch3\u003eSurviving spouse, with or without dependent children\u003c/h3\u003e\u003cp\u003eTo find your monthly payment, select your Veteran’s pay grade category. Find their specific pay grade in the left column of the \u003cstrong\u003eMonthly payment rates\u003c/strong\u003e table, and the matching monthly payment to the right.\u003c/p\u003e\u003cp\u003eThen, go to the \u003cstrong\u003eAdded or increased amounts \u003c/strong\u003etable. Add any added or increased amounts that apply to you based on the Veteran’s disability rating and whether you have dependent children under 18.\u003c/p\u003e"},{"type":"paragraph--collapsible_panel","id":"a9395cfd-a348-4c7a-b842-7a57e8b123cc","entityId":187452,"paragraphs":[{"type":"paragraph--collapsible_panel_item","id":"2ee17376-63a4-41b9-9df3-08e78e737797","entityId":191836,"title":"Enlisted Veteran pay grades E-1 to E-9","wysiwyg":"\u003ch4\u003eMonthly payment rates\u003c/h4\u003e\u003cp\u003eEffective December 1, 2025\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eNote:\u003c/strong\u003e If you’re the surviving spouse of an aviation cadet or other service member not covered by this table, you’ll receive the rate for enlisted E-3.\u003c/p\u003e","paragraphs":[{"type":"paragraph--table","id":"5aa50a23-705c-43ff-a6f5-ac66962f8f96","entityId":192724,"title":"","data":[["Veteran’s pay grade","Monthly payment (in\u0026nbsp;U.S.\u0026nbsp;$)"],["\u003cb\u003eE-1, E-2, E-3, E-4, E-5, E-6\u003c/b\u003e","1,699.36"],["\u003cb\u003eE-7\u003c/b\u003e","1,758.09"],["\u003cb\u003eE-8\u003c/b\u003e","1,856.02"],["\u003cb\u003eE-9 regular\u003c/b\u003e","1,935.72"],["\u003cb\u003eE-9 special capacity\u003c/b\u003e\u003cbr\u003eVeteran served as: \u003cul\u003e\u003cli\u003eSergeant Major of the Army or Marine Corps, \u003cb\u003eor\u003c/b\u003e\u003c/li\u003e\u003cli\u003eSenior enlisted adviser of the Navy, \u003cb\u003eor\u003c/b\u003e\u003c/li\u003e\u003cli\u003eChief Master Sergeant of the Air Force, \u003cb\u003eor\u003c/b\u003e\u003c/li\u003e\u003cli\u003eMaster Chief Petty Officer of the Coast Guard\u003c/li\u003e\u003c/ul\u003e","2,089.58"]]},{"type":"paragraph--table","id":"4a75ec9c-c6bb-4a88-8662-6ef0e8fcac8a","entityId":192730,"title":"Added or increased amounts","data":[["If this description is true…","We’ll adjust your monthly payment by this amount (in\u0026nbsp;U.S.\u0026nbsp;$)"],["\u003cul\u003e\u003cli\u003eThe Veteran had a pay grade of \u003cb\u003eE-1 to E-7\u003c/b\u003e, \u003cb\u003eand\u003c/b\u003e\u003c/li\u003e\u003cli\u003eThe Veteran had a VA disability rating of totally disabling (including for individual unemployability) for at least the 8 full years leading up to their death, \u003cb\u003eand\u003c/b\u003e\u003c/li\u003e\u003cli\u003eYou were married to the Veteran for those same 8 years\u003c/li\u003e\u003c/ul\u003e","Add $360.85"],["\u003cul\u003e\u003cli\u003eThe Veteran had a pay grade of \u003cb\u003eE-8 or E-9\u003c/b\u003e, \u003cb\u003eand\u003c/b\u003e\u003c/li\u003e\u003cli\u003eThe Veteran had a VA disability rating of totally disabling for at least the 8 full years leading up to their death, \u003cb\u003eand\u003c/b\u003e\u003c/li\u003e\u003cli\u003eYou were married to the Veteran for those same 8 years\u003c/li\u003e\u003c/ul\u003e","Increase payment to $2,060.20"],["You have 1 or more children who are under 18","Add $421.00 per child"]]}]},{"type":"paragraph--collapsible_panel_item","id":"b09e3dfd-cca5-496e-a254-254c97223ab1","entityId":191842,"title":"Warrant officer pay grades W-1 to W-4","wysiwyg":null,"paragraphs":[{"type":"paragraph--table","id":"68ee9d0f-8f0b-43fc-8412-246716b368ac","entityId":192736,"title":"Monthly payment rates","data":[["Veteran’s pay grade","Monthly payment (in\u0026nbsp;U.S.\u0026nbsp;$)"],["\u003cb\u003eW-1\u003c/b\u003e","1,794.49"],["\u003cb\u003eW-2\u003c/b\u003e","1,865.80"],["\u003cb\u003eW-3\u003c/b\u003e","1,920.33"],["\u003cb\u003eW-4\u003c/b\u003e","2,032.23"]]},{"type":"paragraph--table","id":"fd5c5775-9e14-4151-b61d-8183e5ea5aee","entityId":192742,"title":"Added or increased amounts","data":[["If this description is true…","We’ll adjust your monthly payment by this amount (in\u0026nbsp;U.S.\u0026nbsp;$)"],["\u003cul\u003e\u003cli\u003eThe Veteran had a VA disability rating of totally disabling (including for individual unemployability) for at least the 8 full years leading up to their death, \u003cb\u003eand\u003c/b\u003e\u003c/li\u003e\u003cli\u003eYou were married to the Veteran for those same 8 years\u003c/li\u003e\u003c/ul\u003e","Increase payment to $2,060.20"],["You have 1 or more children who are under 18","Add $421.00 per child"]]}]},{"type":"paragraph--collapsible_panel_item","id":"ef263930-bab7-4db0-b39d-015040405b90","entityId":191848,"title":"Officer pay grades O-1 to O-10","wysiwyg":null,"paragraphs":[{"type":"paragraph--table","id":"c9333058-849f-416b-9798-92dc6af9e524","entityId":192748,"title":"Monthly payment rates","data":[["Veteran’s pay grade","Monthly payment (in\u0026nbsp;U.S.\u0026nbsp;$)"],["\u003cb\u003eO-1\u003c/b\u003e","1,794.49"],["\u003cb\u003eO-2\u003c/b\u003e","1,856.02"],["\u003cb\u003eO-3\u003c/b\u003e","1,983.26"],["\u003cb\u003eO-4\u003c/b\u003e","2,102.15"],["\u003cb\u003eO-5\u003c/b\u003e","2,313.37"],["\u003cb\u003eO-6\u003c/b\u003e","2,608.49"],["\u003cb\u003eO-7\u003c/b\u003e","2,815.45"],["\u003cb\u003eO-8\u003c/b\u003e","3,092.41"],["\u003cb\u003eO-9\u003c/b\u003e","3,307.79"],["\u003cb\u003eO-10 regular\u003c/b\u003e","3,628.08"],["\u003cb\u003eO-10 special capacity \u003c/b\u003e\u003cbr\u003eVeteran served as:\u003cul\u003e\u003cli\u003eChairman of the Joint Chiefs of Staff, \u003cb\u003eor\u003c/b\u003e\u003c/li\u003e\u003cli\u003eChief of Staff of the Army or Air Force, \u003cb\u003eor\u003c/b\u003e\u003c/li\u003e\u003cli\u003eChief of Naval Operations, \u003cb\u003eor\u003c/b\u003e\u003c/li\u003e\u003cli\u003eCommandant of the Marine Corps\u003c/li\u003e\u003c/ul\u003e","3,893.83"]]},{"type":"paragraph--table","id":"dba1e932-1ece-4219-8c17-89fecad44021","entityId":192754,"title":"Added or increased amounts","data":[["If this description is true…","We’ll adjust your monthly payment by this amount (in\u0026nbsp;U.S.\u0026nbsp;$)"],["\u003cul\u003e\u003cli\u003eThe Veteran had a pay grade of O-1 to O-3, \u003cb\u003eand\u003c/b\u003e\u003c/li\u003e\u003cli\u003eThe Veteran had a VA service-connected disability rating of totally disabling (including for individual unemployability) for at least the 8 full years leading up to their death, \u003cb\u003eand\u003c/b\u003e\u003c/li\u003e\u003cli\u003eYou were married to the Veteran for those same 8 years\u003c/li\u003e\u003c/ul\u003e","Increase payment to $2,060.20"],["You have 1 or more children who are under 18","Add $421.00 per child"]]}]}],"bordered":false},{"type":"paragraph--wysiwyg","id":"2f31eb02-affd-4597-be4e-9cd99aa9bea3","html":"\u003ch4\u003eExample\u0026nbsp;of how to calculate your monthly payment\u003c/h4\u003e\u003cp\u003eIf you’re the surviving spouse of a Veteran whose pay grade was E-3, your monthly rate would start at \u003cstrong\u003e$1,699.36\u003c/strong\u003e.\u003c/p\u003e\u003cp\u003eThen for each additional benefit you qualify for, you would add or adjust your monthly rate using the \u003cstrong\u003eAdded or increased amounts\u003c/strong\u003e table.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eIn this example:\u003c/strong\u003e We show the total monthly payment for someone with the E-3 monthly rate who qualifies for the 8-year provision and has 2 children under 18.\u003c/p\u003e\u003cp\u003e$1,699.36 (monthly rate)\u003cbr\u003e+ $360.85\u0026nbsp;(8-year provision for E-3 pay grade)\u003cbr\u003e+ $421.00\u0026nbsp;(rate for first child under age 18)\u003cbr\u003e+ $421.00\u0026nbsp;(rate for second child under age 18)\u003cbr\u003e= \u003cstrong\u003e$2,902.21 total monthly payment\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eIf you were the surviving spouse of a Veteran whose pay grade was\u003cstrong\u003e E-9\u003c/strong\u003e, \u003cstrong\u003eand\u003c/strong\u003e you qualified for the 8-year provision, \u003cstrong\u003eand\u003c/strong\u003e you had 2 dependent children under 18, you would calculate your monthly payment as in this example:\u003c/p\u003e\u003cp\u003e$2,060.21 (increased payment for Veteran with pay grade of E-8 or E-9, with 8-year provision)\u003cbr\u003e+ $421.00\u0026nbsp;(rate for first child under 18)\u003cbr\u003e+ $421.00 (rate for second child under 18)\u003cbr\u003e\u003cstrong\u003e= $2,902.21 total monthly payment\u003c/strong\u003e\u003c/p\u003e"},{"type":"paragraph--wysiwyg","id":"30e61ed4-d3dd-40f6-87d3-98f8e9f1cf93","html":"\u003chr\u003e\u003ch2 id=\"monthly-rates-if-youre-the-sur\"\u003eMonthly rates if you’re the surviving child of a Veteran\u003c/h2\u003e\u003cp\u003eFind the survivor status that applies to you.\u003c/p\u003e\u003ch3\u003eSurviving, unmarried adult child of a Veteran, when the Veteran’s surviving spouse is also eligible for Dependency and Indemnity Compensation\u003c/h3\u003e\u003cp\u003eWe make this monthly payment to you separately as the adult surviving child, in addition to the eligible surviving spouse’s compensation.\u003c/p\u003e\u003ch4\u003eMonthly payment rates\u003c/h4\u003e\u003cp\u003eEffective December 1, 2025\u003c/p\u003e"},{"type":"paragraph--table","id":"6a528d64-43ab-46bf-970b-4d190de5324b","entityId":187470,"title":"","data":[["Child status","Monthly payment (in\u0026nbsp;U.S.\u0026nbsp;$)"],["Child between 18 and 23 who’s in a qualified school program","356.66"],["Helpless child over 18 \u003cbr\u003e(An adult child who became permanently unable to support themselves before age 18)","717.50"]]},{"type":"paragraph--wysiwyg","id":"ca32a53f-b825-46fd-bfe3-ea19b55eaa13","html":"\u003ch3\u003eSurviving eligible child of a Veteran, when the Veteran doesn’t have a surviving spouse who’s eligible for Dependency and Indemnity Compensation\u003c/h3\u003e\u003cp\u003eWe’ll base your payment amount on the number of the Veteran’s eligible surviving children. You’re an eligible child\u0026nbsp;if you meet\u0026nbsp;at least 1 of these requirements.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eAt least 1 of these must be true:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou’re under 18, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’re between 18 and 23 and in a VA-approved school program, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’re permanently unable to support yourself due to a disability that happened before age 18 (we use the term\u0026nbsp;“helpless child”)\u003c/li\u003e\u003c/ul\u003e\u003ch4\u003eMonthly payment rates\u003c/h4\u003e\u003cp\u003eEffective December 1, 2025\u003c/p\u003e"},{"type":"paragraph--table","id":"d01e8464-0c86-4912-b4bc-d52cfa1347c8","entityId":187482,"title":"","data":[["Number of Veteran’s eligible children","Monthly rate for each child (in\u0026nbsp;U.S.\u0026nbsp;$)","Total monthly payment (in\u0026nbsp;U.S.\u0026nbsp;$)"],["\u003cb\u003e1\u003c/b\u003e","717.50","717.50"],["\u003cb\u003e2\u003c/b\u003e","516.09","1,032.18"],["\u003cb\u003e3\u003c/b\u003e","448.97","1,346.92"],["\u003cb\u003e4\u003c/b\u003e","400.72","1,602.87"],["\u003cb\u003e5\u003c/b\u003e","371.76","1,858.82"],["\u003cb\u003e6\u003c/b\u003e","352.46","2,114.77"],["\u003cb\u003e7\u003c/b\u003e","338.67","2,370.72"],["\u003cb\u003e8\u003c/b\u003e","328.33","2,626.67"],["\u003cb\u003e9\u003c/b\u003e","320.29","2,882.62"]]},{"type":"paragraph--wysiwyg","id":"f0db2eca-a529-423b-9806-fd4501e36afd","html":"\u003ch4\u003eAdded amounts\u003c/h4\u003e\u003cul\u003e\u003cli\u003eFor each additional eligible child in a family of 10 or more children, add $255.95.\u003c/li\u003e\u003cli\u003eFor each helpless child over 18, add $421 to your monthly rate above. This will be your\u0026nbsp;total monthly payment. For example, if there are 2\u0026nbsp;eligible surviving children, and 1 of them is a helpless child, the rate for that child would be $937.09 ($516.09\u0026nbsp;+ $421).\u003c/li\u003e\u003c/ul\u003e"},{"type":"paragraph--wysiwyg","id":"82c3447b-edaf-421a-bee0-852c901828dd","html":"\u003chr\u003e\u003ch2 id=\"how-dependency-and-indemnity-c\"\u003eHow Dependency and Indemnity Compensation may affect your VA Survivors Pension or Survivor Benefit Plan\u003c/h2\u003e\u003ch3\u003eHow do my payments for Dependency and Indemnity Compensation affect my ability to receive VA Survivors Pension?\u003c/h3\u003e\u003cp\u003eIf you’re eligible for both Dependency and Indemnity Compensation and Survivors Pension benefits, we’ll pay you whichever benefit gives you the most money. You can’t get both.\u003c/p\u003e\u003cp\u003e\u003ca href=\"/family-and-caregiver-benefits/survivor-compensation/survivors-pension\" data-entity-type=\"node\" data-entity-uuid=\"3cab46c4-e831-431f-9155-baae533fd949\" data-entity-substitution=\"canonical\" title=\"Survivors Pension\"\u003eLearn more about Survivors Pension benefits\u003c/a\u003e\u003c/p\u003e\u003cp\u003e\u003ca href=\"/family-and-caregiver-benefits/survivor-compensation/survivors-pension/rates\" data-entity-type=\"node\" data-entity-uuid=\"6b525ed4-168d-4f45-a62d-474d7174b4fa\" data-entity-substitution=\"canonical\" title=\"Current Survivors Pension benefit rates\"\u003eCheck current VA Survivors Pension benefit rates\u003c/a\u003e\u003c/p\u003e\u003ch3\u003eWhat’s a Survivor Benefit Plan?\u003c/h3\u003e\u003cp\u003eThe Survivor Benefit Program is a voluntary annuity program that service members may buy as a retirement benefit for their family members. An annuity is a monthly payment received for life. Depending on their military service, members may use this program to buy a Survivor Benefit Plan (SBP) or Reserve Component Survivor Benefit Plan (RCSBP).\u003c/p\u003e\u003cp\u003eWe don’t manage this program. It’s managed by the Defense Finance and Accounting Service (DFAS) at the Defense Department.\u003c/p\u003e\u003cp\u003eIf you have questions about your SBP or RCSBP payments, you can call DFAS at \u003cva-telephone contact=\"800-321-1080\" extension=\"\"\u003e\u003c/va-telephone\u003e\u0026nbsp;(TTY: 711).\u0026nbsp;They’re open Monday through Friday,\u0026nbsp;8:00 a.m. to 5:00 p.m. ET.\u003c/p\u003e\u003ch3\u003eCan I get SBP or RCSBP payments and Dependency and Indemnity Compensation at the same time?\u003c/h3\u003e\u003cp\u003eYes. You can get a full SBP or RCSBP payment and a full Dependency and Indemnity Compensation payment at the same time.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eNote:\u003c/strong\u003e In the past, DFAS reduced your SBP or RCSBP payments by a percentage of your Dependency and Indemnity Compensation payment. This was called the “SBP-D.I.C. Offset.” Starting on January 1, 2021, DFAS began reducing the offset in phases. On January 1, 2023, DFAS fully eliminated the offset. Survivors can now get full benefits for both programs.\u003c/p\u003e\u003cp\u003e\u003ca href=\"https://www.dfas.mil/RetiredMilitary/survivors/SBP-DIC-News/\"\u003eLearn more about the end of the SBP-D.I.C. Offset on the DFAS website\u003c/a\u003e\u003c/p\u003e\u003chr\u003e\u003ch2 id=\"past-rates\"\u003ePast rates\u003c/h2\u003e\u003cp\u003eReview surviving spouse and child rates for Dependency and Indemnity Compensation for past years.\u003c/p\u003e\u003cp\u003e\u003ca href=\"/family-and-caregiver-benefits/survivor-compensation/dependency-indemnity-compensation/survivor-rates/past-rates-2025\" data-entity-type=\"node\" data-entity-uuid=\"aa269010-b004-4a89-a5e7-05524201bc8e\" data-entity-substitution=\"canonical\" title=\"Past rates: 2025 D.I.C. rates for spouses and dependents\"\u003e2025 rates\u003c/a\u003e (effective December 1, 2024)\u003cbr\u003e\u003ca href=\"/family-and-caregiver-benefits/survivor-compensation/dependency-indemnity-compensation/survivor-rates/past-rates-2024\" data-entity-type=\"node\" data-entity-uuid=\"448a27a3-5e78-46f8-8e04-c28a1a1ce5f2\" data-entity-substitution=\"canonical\" title=\"Past rates: 2024 D.I.C. rates for spouses and dependents\"\u003e2024 rates\u003c/a\u003e (effective December 1, 2023)\u003cbr\u003e\u003ca href=\"/family-and-caregiver-benefits/survivor-compensation/dependency-indemnity-compensation/survivor-rates/past-rates-2023\" data-entity-type=\"node\" data-entity-uuid=\"d552460e-f9be-4057-8af6-2a2551a9a567\" data-entity-substitution=\"canonical\" title=\"Past rates: 2023 D.I.C. rates for spouses and dependents\"\u003e2023 rates\u003c/a\u003e (effective December 1, 2022)\u003c/p\u003e\u003ch2 id=\"full-title-38-regulations\"\u003eFull Title 38 regulations\u003c/h2\u003e\u003cp\u003eRead the full regulations from Title 38 Code of Federal Regulations.\u003c/p\u003e\u003ch3\u003eFull section\u003c/h3\u003e\u003cp\u003e\u003ca href=\"https://www.govinfo.gov/app/details/USCODE-2011-title38/USCODE-2011-title38-partII-chap13-subchapII\"\u003e38 U.S.C. II Dependency and Indemnity Compensation (chapter 13, sections 1310 to 1318)\u003c/a\u003e\u003cbr\u003e\u003ca href=\"https://www.ecfr.gov/current/title-38/chapter-I/part-3#sp38.1.3.a\"\u003e38 U.S.C. 501(a) Subpart A—Pension, Compensation, and Dependency and Indemnity Compensation\u003c/a\u003e\u003c/p\u003e\u003ch3\u003eDetails related to rates for surviving spouses and children\u003c/h3\u003e\u003cp\u003e\u003ca href=\"https://www.ecfr.gov/current/title-38/chapter-I/part-3#se38.1.3_15\"\u003e3.5 Dependency and indemnity compensation\u003c/a\u003e\u003cbr\u003e\u003ca href=\"https://www.ecfr.gov/current/title-38/chapter-I/part-3#se38.1.3_110\"\u003e3.10 Dependency and indemnity compensation rate for a surviving spouse\u003c/a\u003e\u003cbr\u003e\u003ca href=\"https://www.ecfr.gov/current/title-38/chapter-I/part-3#se38.1.3_122\"\u003e3.22 D.I.C. benefits for survivors of certain Veterans rated totally disabled at time of death\u003c/a\u003e\u003c/p\u003e"}],"relatedLinks":{"type":"paragraph--list_of_link_teasers","id":"98d2f9ad-08a2-45f3-8c6a-8c4a3c5b9144","entityId":188745,"title":"Other information you may need","linkTeasers":[{"type":"paragraph--link_teaser","id":"70f22f7b-1065-402a-99ce-037fdd82a8ce","entityId":191854,"href":"/family-and-caregiver-benefits/survivor-compensation/survivors-pension/","label":"VA Survivors Pension","summary":"If you’re the surviving spouse or child of a Veteran with wartime service, find out if you’re eligible for monthly pension benefits based on your income and net worth."},{"type":"paragraph--link_teaser","id":"832a3dec-249f-438b-bcc2-49a8d55a37a0","entityId":191860,"href":"/family-and-caregiver-benefits/health-and-disability/","label":"Healthcare for spouses, dependents, and family caregivers","summary":"Find out if you may qualify for healthcare benefits through a program such as CHAMPVA or the Defense Department’s TRICARE program."},{"type":"paragraph--link_teaser","id":"0670274e-ff8b-43e0-b835-d7a275e20aad","entityId":191866,"href":"/family-and-caregiver-benefits/education-and-careers/","label":"VA education benefits for survivors and dependents","summary":"Find out if you may be eligible for education benefits or job training through a GI Bill program."},{"type":"paragraph--link_teaser","id":"8c26d845-f7db-40a3-b4db-4f50b9be244b","entityId":191872,"href":"/family-and-caregiver-benefits/","label":"Family member benefits","summary":"Learn how to apply for and manage other benefits available to the family members of Veterans and service members."},{"type":"paragraph--link_teaser","id":"84d50e9a-8bc9-421c-8cd5-89a2c526fe26","entityId":192163,"href":"https://www.knowva.ebenefits.va.gov/system/templates/selfservice/va_ssnew/help/customer/locale/en-US/portal/554400000001018/content/554400000016337/Dependency-and-Indemnity-Compensation-Widowers-and-Children","label":"Past rates for surviving spouses and dependents on KnowVA","summary":"Find past rates (back to 1977) on the KnowVA website."}]},"administration":{"entityId":1181,"name":"Family and caregiver benefits hub"},"menu":{"rootPath":"/family-and-caregiver-benefits/survivor-compensation/dependency-indemnity-compensation/survivor-rates/","data":{"name":"Family and caregiver benefits","description":null,"links":[{"description":null,"expanded":true,"label":"Family and caregiver benefits","links":[{"description":null,"expanded":false,"label":"Get benefits","links":[{"description":null,"expanded":true,"label":"Health and disability benefits","links":[{"description":null,"expanded":false,"label":"CHAMPVA benefits","links":[{"description":null,"expanded":false,"label":"Apply now","links":[],"url":{"path":"https://www.va.gov/family-and-caregiver-benefits/health-and-disability/champva/apply-form-10-10d/"},"lovellSection":null},{"description":null,"expanded":false,"label":"Submit other health insurance","links":[],"url":{"path":"https://www.va.gov/family-and-caregiver-benefits/health-and-disability/champva/submit-other-insurance-form-10-7959c/"},"lovellSection":null},{"description":"Use this form if you’re currently enrolled in The Civilian Health and Medical Program of the Department of Veterans Affairs (CHAMPVA) and want to file a claim for reimbursement.","expanded":false,"label":"File a CHAMPVA claim","links":[],"url":{"path":"https://www.va.gov/family-and-caregiver-benefits/health-and-disability/champva/file-champva-claim-10-7959a/"},"lovellSection":null}],"url":{"path":"/family-and-caregiver-benefits/health-and-disability/champva"},"lovellSection":null},{"description":null,"expanded":true,"label":"Program of Comprehensive Assistance for Family Caregivers","links":[{"description":null,"expanded":false,"label":"Apply now","links":[],"url":{"path":"https://www.va.gov/family-and-caregiver-benefits/health-and-disability/comprehensive-assistance-for-family-caregivers/apply-form-10-10cg/introduction"},"lovellSection":null}],"url":{"path":"/family-and-caregiver-benefits/health-and-disability/comprehensive-assistance-for-family-caregivers"},"lovellSection":null},{"description":null,"expanded":true,"label":"El Programa de Asistencia Integral para Cuidadores de Familia","links":[{"description":null,"expanded":false,"label":"Solicite ahora (en inglés)","links":[],"url":{"path":"https://www.va.gov/family-and-caregiver-benefits/health-and-disability/comprehensive-assistance-for-family-caregivers/apply-form-10-10cg/introduction"},"lovellSection":null}],"url":{"path":"/family-and-caregiver-benefits/health-and-disability/comprehensive-assistance-for-family-caregivers-esp"},"lovellSection":null},{"description":null,"expanded":false,"label":"Benefits for spina bifida linked to Agent Orange","links":[],"url":{"path":"/family-and-caregiver-benefits/health-and-disability/spina-bifida-agent-orange"},"lovellSection":null},{"description":null,"expanded":false,"label":"Benefits for children of women Vietnam Veterans","links":[],"url":{"path":"/family-and-caregiver-benefits/health-and-disability/children-of-women-vietnam-veterans"},"lovellSection":null}],"url":{"path":"/family-and-caregiver-benefits/health-and-disability"},"lovellSection":null},{"description":null,"expanded":false,"label":"Survivor compensation","links":[{"description":null,"expanded":false,"label":"Dependency and Indemnity Compensation (D.I.C.)","links":[{"description":null,"expanded":false,"label":"Spouse and dependent rates","links":[{"description":null,"expanded":false,"label":"Past rates: 2025","links":[],"url":{"path":"/family-and-caregiver-benefits/survivor-compensation/dependency-indemnity-compensation/survivor-rates/past-rates-2025"},"lovellSection":null},{"description":null,"expanded":false,"label":"Past rates: 2024","links":[],"url":{"path":"/family-and-caregiver-benefits/survivor-compensation/dependency-indemnity-compensation/survivor-rates/past-rates-2024"},"lovellSection":null},{"description":null,"expanded":false,"label":"Past rates: 2023","links":[],"url":{"path":"/family-and-caregiver-benefits/survivor-comp