"gov-banner" aria-hidden="true"><div class="vads-grid-row"><div class="usa-banner-guidance-gov vads-grid-col-6"><img alt="Dot gov" loading="lazy" width="38" height="38" decoding="async" data-nimg="1" class="usa-banner-icon usa-media_block-img" style="color:transparent" src="/img/icon-dot-gov.svg"/><div class="usa-media_block-body"><p><strong>The .gov means it’s official.</strong><br/>Federal government websites often end in .gov or .mil. Before sharing sensitive information, make sure you&#x27;re on a federal government site.</p></div></div><div class="usa-banner-guidance-ssl vads-grid-col-6"><img alt="SSL" loading="lazy" width="38" height="38" decoding="async" data-nimg="1" class="usa-banner-icon usa-media_block-img" style="color:transparent" src="/img/icon-https.svg"/><div class="usa-media_block-body"><p><strong>The site is secure.</strong><br/> The <strong>https://</strong> ensures that you&#x27;re connecting to the official website and that any information you provide is encrypted and sent securely.</p></div></div></div></div></div></div></div><div class="va-crisis-line-container vads-u-background-color--secondary-darkest"><button class="va-crisis-line va-overlay-trigger vads-u-background-color--secondary-darkest" data-show="#modal-crisisline"><div class="va-crisis-line-inner"><span class="va-crisis-line-icon" aria-hidden="true"></span><span class="va-crisis-line-text">Talk to the <strong>Veterans Crisis Line</strong> now</span><img alt="" aria-hidden="true" loading="lazy" width="13" height="29" decoding="async" data-nimg="1" class="va-crisis-line-arrow" style="color:transparent" src="/img/arrow-right-white.svg"/></div></button></div></div><div class="vads-grid-container vads-u-padding-x--0 desktop:vads-u-padding-x--1p5" id="va-header-logo-menu"><div class="vads-grid-row va-flex vads-u-margin-x--1p5"><div class="va-header-logo-wrapper"><a href="/" class="va-header-logo"><img alt="VA logo and Seal, U.S. Department of Veterans Affairs" loading="lazy" width="264" height="59" decoding="async" data-nimg="1" style="color:transparent" src="/img/header-logo.png"/></a></div><div class="tablet:vads-u-display--none vads-grid-container"><div class="menu-rule"></div><div class="mega-menu" id="mega-menu-mobile"></div></div><div id="login-root" class="vet-toolbar vads-u-margin-y--0p5"></div></div></div><div class="vads-grid-container vads-u-padding-x--0"><div class="vads-u-width--full vads-u-align-items--center"><div class="menu-rule vads-u-margin-x--0"></div></div><div class="mega-menu" id="mega-menu"></div></div></div><div data-widget-type="maintenance-banner" data-testid="maintenance-banner"></div></header><div data-widget-type="situation-updates-banner"></div><div class="vads-grid-container" style="min-height:5.125rem"><va-breadcrumbs class="vads-grid-row" wrapping="" breadcrumb-list="[{&quot;href&quot;:&quot;/&quot;,&quot;label&quot;:&quot;Home&quot;},{&quot;href&quot;:&quot;/disability&quot;,&quot;label&quot;:&quot;Disability benefits&quot;},{&quot;href&quot;:&quot;/disability/compensation-rates&quot;,&quot;label&quot;:&quot;Disability compensation rates&quot;},{&quot;href&quot;:&quot;&quot;,&quot;label&quot;:&quot;Current special monthly compensation rates&quot;}]"></va-breadcrumbs></div><main lang="en"><div id="content" class="interior"><div class="vads-grid-container va-l-detail-page"><div class="template-module__9NNqyG__gridRow va-sidebarnav-wrapper vads-grid-row vads-u-flex-wrap--nowrap"><nav data-template="navigation/sidebar_nav" aria-label="Secondary" id="va-detailpage-sidebar" data-drupal-sidebar="true" class="va-drupal-sidebarnav va-sidebarnav vads-grid-col-3 vads-u-margin-bottom--2"><div aria-modal="true" role="dialog" aria-labelledby="sidebar_header"><button class="va-sidenav-btn-close va-sidebarnav-close" type="button" aria-label="Close this menu"><va-icon icon="close" size="3" class="vads-u-color--gray-dark"></va-icon></button><div class="vads-u-display--flex vads-u-align-items--center left-side-nav-title"><va-icon icon="description" size="3" class="hub-icon vads-u-color--white vads-u-display--flex vads-u-align-items--center vads-u-justify-content--center vads-u-margin-right--1 vads-u-background-color--hub-disability"></va-icon><h4 id="sidebar_header">Disability benefits</h4></div><div class="sidenav-previous-page"><a href="/disability/compensation-rates">Disability compensation rates</a></div><ul class="usa-sidenav-list"><li class=""><a class="" href="/disability/compensation-rates/veteran-rates">Veterans disability compensation rates</a><ul class="usa-sidenav-sub_list"><li><a class="" href="/disability/compensation-rates/veteran-rates/past-rates-2025">Past rates: 2025</a></li><li><a class="" href="/disability/compensation-rates/veteran-rates/past-rates-2024">Past rates: 2024</a></li><li><a class="" href="/disability/compensation-rates/veteran-rates/past-rates-2023">Past rates: 2023</a></li></ul></li><li class="active-level"><a class="usa-current" href="/disability/compensation-rates/special-monthly-compensation-rates">Special monthly compensation rates</a><ul class="usa-sidenav-sub_list"><li><a class="" href="/disability/compensation-rates/special-monthly-compensation-rates/past-rates-2025">Past rates: 2025</a></li><li><a class="" href="/disability/compensation-rates/special-monthly-compensation-rates/past-rates-2024">Past rates: 2024</a></li><li><a class="" href="/disability/compensation-rates/special-monthly-compensation-rates/past-rates-2023">Past rates: 2023</a></li></ul></li><li class=""><a class="" href="/disability/compensation-rates/special-benefit-allowance-rates">Special benefit allowances rates</a><ul class="usa-sidenav-sub_list"><li><a class="" href="/disability/compensation-rates/special-benefit-allowance-rates/past-rates-2025">Past rates: 2025</a></li><li><a class="" href="/disability/compensation-rates/special-benefit-allowance-rates/past-rates-2024">Past rates: 2024</a></li><li><a class="" href="/disability/compensation-rates/special-benefit-allowance-rates/past-rates-2023">Past rates: 2023</a></li></ul></li><li class=""><a class="" href="/disability/compensation-rates/birth-defect-rates">Birth defect compensation rates</a><ul class="usa-sidenav-sub_list"><li><a class="" href="/disability/compensation-rates/birth-defect-rates/past-rates-2025">Past rates: 2025</a></li><li><a class="" href="/disability/compensation-rates/birth-defect-rates/past-rates-2024">Past rates: 2024</a></li><li><a class="" href="/disability/compensation-rates/birth-defect-rates/past-rates-2023">Past rates: 2023</a></li></ul></li></ul></div></nav><div class="va-btn-sidebarnav-trigger"><div class="sidenav-trigger-sentinel"></div><div class="" id="sidenav-trigger"><button aria-controls="va-detailpage-sidebar"><strong>In this section</strong><va-icon icon="menu" size="3" class="vads-u-color--link-default"></va-icon></button></div></div><div class="vads-grid-row"><div class="vads-grid-col-12"><script type="application/ld+json">{"@context":"https://schema.org","@type":"WebPage","name":"Current special monthly compensation rates","headline":"Current special monthly compensation rates","description":"VA special monthly compensation (SMC) is a higher rate of compensation that we pay to Veterans as well as their spouses, surviving spouses, and parents with certain needs or disabilities. Find the 2026 special monthly compensation rates that may apply to you.","url":"https://www.va.gov/disability/compensation-rates/special-monthly-compensation-rates/"}</script><article class="usa-content vads-u-padding-bottom--0"><div data-widget-type="i18-select"></div><h1>Current special monthly compensation rates</h1><div class="va-introtext"><p>VA special monthly compensation (SMC) is a higher rate of compensation that we pay to Veterans as well as their spouses, surviving spouses, and parents with certain needs or disabilities. Find the 2026 special monthly compensation rates that may apply to you.</p>
</div><div data-template="paragraphs/wysiwyg" data-paragraph-type="paragraph--wysiwyg"><div itemProp="text"><h2 id="special-monthly-compensation-r">Special monthly compensation rate payment variations</h2><p><strong>Effective December 1, 2025</strong></p><p><strong>Levels K and Q</strong> are special rates called SMC&nbsp;rate payment variations. We may add Level K to your basic SMC rate.</p></div></div><div id="7cea1dcf-dcf2-4332-a4f1-be570c38b674" data-template="paragraphs/collapsible_panel" data-paragraph-type="paragraph--collapsible_panel" data-entity-id="187388"><va-accordion><va-accordion-item class="va-accordion-item" id="smc-k-and-smc-q-rates-85c3bf44-1cb2-4bc1-9700-8560a6674ca3"><h3 slot="headline">SMC-K and SMC-Q rates</h3><div id="85c3bf44-1cb2-4bc1-9700-8560a6674ca3" data-template="paragraphs/collapsible_panel__panel" data-paragraph-type="paragraph--collapsible_panel_item" data-entity-id="191182" data-analytics-faq-text="SMC-K and SMC-Q rates"><div id="collapsible_panel_item-191182"><va-table table-title="SMC rate payment variations" table-type="bordered"><va-table-row slot="headers"><span>SMC letter designation</span><span>Monthly payment (in&nbsp;U.S.&nbsp;$)</span><span>How this payment variation works</span></va-table-row><va-table-row slot=""><span><b> SMC-K </b></span><span>139.87</span><span>If you qualify for SMC-K, we add this rate to your basic disability compensation rate for any disability rating from 0% to 100%. We also add this rate to all SMC basic rates except SMC-O, SMC-Q, and SMC-R. You may receive 1 to 3 SMC-K awards in addition to basic and SMC rates.</span></va-table-row><va-table-row slot=""><span><b> SMC-Q </b></span><span>67.00</span><span>This is a protected rate that we haven’t awarded since August 19, 1968. If we awarded you an SMC-Q designation, we pay this rate in place of your basic disability compensation rate.</span></va-table-row></va-table></div></div></va-accordion-item></va-accordion></div><div data-template="paragraphs/wysiwyg" data-paragraph-type="paragraph--wysiwyg"><div itemProp="text"><h2 id="special-monthly-compensation-r">Special monthly compensation rates for Veterans without children</h2><p><strong>Effective December 1, 2025</strong></p><p><strong>Levels L through O</strong> cover specific disabilities and situations.</p><p><a href="#how-we-assign-smc-levels-l-thr">Learn how we assign SMC levels L through O</a></p><p><strong>Level R</strong> may apply if you need daily help from another person for basic needs (like dressing, eating, and bathing).</p><p><strong>Level S</strong> may apply if you can’t leave the house because of your service-connected disabilities.</p></div></div><div id="0a551c19-e87e-4406-b5af-8174821ee046" data-template="paragraphs/collapsible_panel" data-paragraph-type="paragraph--collapsible_panel" data-entity-id="187396"><va-accordion><va-accordion-item class="va-accordion-item" id="smc-l-through-smc-n-rates-1447bb0c-6d12-49ac-8c1a-46ea03f372a5"><h3 slot="headline">SMC-L through SMC-N rates</h3><div id="1447bb0c-6d12-49ac-8c1a-46ea03f372a5" data-template="paragraphs/collapsible_panel__panel" data-paragraph-type="paragraph--collapsible_panel_item" data-entity-id="191186" data-analytics-faq-text="SMC-L through SMC-N rates"><div id="collapsible_panel_item-191186"><div itemProp="text"><p>Start with the <strong>Basic SMC rates</strong> table. Find the dependent status in the left column that best describes you. Then find your SMC letter designation in the top row. Your monthly basic rate is where your dependent status and SMC letter meet.</p><p>If you have more than 1 child or your spouse receives&nbsp;Aid and Attendance benefits,<strong>&nbsp;</strong>be sure to also check the&nbsp;<strong>Added amounts</strong>&nbsp;table,&nbsp;and add these to your amount from the&nbsp;<strong>Basic SMC rates</strong>&nbsp;table.</p><p><a href="/pension/aid-attendance-housebound" data-entity-type="node" data-entity-uuid="131d0c40-3680-4001-881e-e621eeae7337" data-entity-substitution="canonical" hreflang="en" title="VA Aid and Attendance benefits and Housebound allowance">Learn more about Aid and Attendance benefits</a></p></div><va-table table-title="Basic SMC rates" table-type="bordered"><va-table-row slot="headers"><span>Dependent status</span><span>SMC-L (in&nbsp;U.S.&nbsp;$)</span><span>SMC-L 1/2 (in&nbsp;U.S.&nbsp;$)</span><span>SMC-M (in&nbsp;U.S.&nbsp;$)</span><span>SMC-M 1/2 (in&nbsp;U.S.&nbsp;$)</span><span>SMC-N (in&nbsp;U.S.&nbsp;$)</span></va-table-row><va-table-row slot=""><span><strong>Veteran alone</strong><p>(no dependents)</p></span><span>4,900.83</span><span>5,154.00</span><span>5,408.55</span><span>5,780.00</span><span>6,152.64</span></va-table-row><va-table-row slot=""><span><strong>With spouse</strong><p>(no parents or children)</p></span><span>5,120.42</span><span>5,373.59</span><span>5,628.14</span><span>5,999.59</span><span>6,372.23</span></va-table-row><va-table-row slot=""><span><strong>With spouse and 1 parent</strong><p>(no children)</p></span><span>5,296.66</span><span>5,549.83</span><span>5,804.38</span><span>6,175.83</span><span>6,548.47</span></va-table-row><va-table-row slot=""><span><strong>With spouse and 2 parents</strong><p>(no children)</p></span><span>5,472.90</span><span>5,726.07</span><span>5,980.62</span><span>6,352.07</span><span>6,724.71</span></va-table-row><va-table-row slot=""><span><strong>With 1 parent </strong><p>(no spouse or children)</p></span><span>5,077.07</span><span>5,330.24</span><span>5,584.79</span><span>5,956.24</span><span>6,328.88</span></va-table-row><va-table-row slot=""><span><strong>With 2 parents</strong><p>(no spouse or children)</p></span><span>5,253.31</span><span>5,506.48</span><span>5,761.03</span><span>6,132.48</span><span>6,505.12</span></va-table-row></va-table><va-table table-title="Added amounts" table-type="bordered"><va-table-row slot="headers"><span>Dependent status</span><span>SMC-L (in&nbsp;U.S.&nbsp;$)</span><span>SMC-L 1/2 (in&nbsp;U.S.&nbsp;$)</span><span>SMC-M (in&nbsp;U.S.&nbsp;$)</span><span>SMC-M&nbsp;1/2 (in&nbsp;U.S.&nbsp;$)</span><span>SMC-N (in&nbsp;U.S.&nbsp;$)</span></va-table-row><va-table-row slot=""><span><strong>Spouse receiving Aid and Attendance</strong></span><span>201.41</span><span>201.41</span><span>201.41</span><span>201.41</span><span>201.41</span></va-table-row></va-table></div></div></va-accordion-item><va-accordion-item class="va-accordion-item" id="smc-n-12-through-smc-s-d3792984-5c4a-4b76-b9bc-a5d754ad3a51"><h3 slot="headline">SMC-N 1/2 through SMC-S</h3><div id="d3792984-5c4a-4b76-b9bc-a5d754ad3a51" data-template="paragraphs/collapsible_panel__panel" data-paragraph-type="paragraph--collapsible_panel_item" data-entity-id="191190" data-analytics-faq-text="SMC-N 1/2 through SMC-S"><div id="collapsible_panel_item-191190"><div itemProp="text"><p>Start with the <strong>Basic SMC rates</strong> table. Find the dependent status in the left column that best describes you. Then find your SMC letter designation in the top row. Your monthly basic rate is where your dependent status and SMC letter meet.</p><p>If you have more than 1 child or your spouse receives&nbsp;Aid and Attendance benefits,<strong>&nbsp;</strong>be sure to also check the&nbsp;<strong>Added amounts</strong>&nbsp;table,&nbsp;and add these to your amount from the&nbsp;<strong>Basic SMC rates</strong>&nbsp;table.</p><p><a href="/pension/aid-attendance-housebound" data-entity-type="node" data-entity-uuid="131d0c40-3680-4001-881e-e621eeae7337" data-entity-substitution="canonical" hreflang="en" title="VA Aid and Attendance benefits and Housebound allowance">Learn more about Aid and Attendance benefits</a></p></div><va-table table-title="Basic SMC rates" table-type="bordered"><va-table-row slot="headers"><span>Dependent status</span><span>SMC-N 1/2 (in&nbsp;U.S.&nbsp;$)</span><span>SMC-O/P (in&nbsp;U.S.&nbsp;$)</span><span>SMC-R.1 (in&nbsp;U.S.&nbsp;$)</span><span>SMC-R.2/T (in&nbsp;U.S.&nbsp;$)</span><span>SMC-S (in&nbsp;U.S.&nbsp;$)</span></va-table-row><va-table-row slot=""><span><strong>Veteran alone</strong><p>(no dependents)</p></span><span>6,514.00</span><span>6,877.12</span><span>9,826.88</span><span>11,271.67</span><span>4,408.53</span></va-table-row><va-table-row slot=""><span><strong>With spouse</strong><p>(no parents or children)</p></span><span>6,733.59</span><span>7,096.71</span><span>10,046.47</span><span>11,491.26</span><span>4,628.12</span></va-table-row><va-table-row slot=""><span><strong>With spouse and 1 parent</strong><p>(no children)</p></span><span>6,909.83</span><span>7,272.95</span><span>10,222.71</span><span>11,667.50</span><span>4,804.36</span></va-table-row><va-table-row slot=""><span><strong>With spouse and 2 parents</strong><p>(no children)</p></span><span>7,086.07</span><span>7,449.19</span><span>10,398.95</span><span>11,843.74</span><span>4,980.60</span></va-table-row><va-table-row slot=""><span><strong>With 1 parent</strong><p>(no spouse or children)</p></span><span>6,690.24</span><span>7,053.36</span><span>10,003.12</span><span>11,447.91</span><span>4,584.77</span></va-table-row><va-table-row slot=""><span><strong>With 2 parents</strong><p>(no spouse or children)</p></span><span>6,866.48</span><span>7,229.60</span><span>10,179.36</span><span>11,624.15</span><span>4,761.01</span></va-table-row></va-table><va-table table-title="Added amounts" table-type="bordered"><va-table-row slot="headers"><span>Dependent status</span><span>SMC-N 1/2 (in&nbsp;U.S.&nbsp;$)</span><span>SMC-O/P (in&nbsp;U.S.&nbsp;$)</span><span>SMC-R.1 (in&nbsp;U.S.&nbsp;$)</span><span>SMC-R.2/T (in&nbsp;U.S.&nbsp;$)</span><span>SMC-S (in&nbsp;U.S.&nbsp;$)</span></va-table-row><va-table-row slot=""><span><strong>Spouse receiving Aid and Attendance</strong></span><span>201.41</span><span>201.41</span><span>201.41</span><span>201.41</span><span>201.41</span></va-table-row></va-table></div></div></va-accordion-item></va-accordion></div><div data-template="paragraphs/wysiwyg" data-paragraph-type="paragraph--wysiwyg"><div itemProp="text"><h2 id="special-monthly-compensation-r">Special monthly compensation rates for Veterans with dependents, including children</h2><p><strong>Effective December 1, 2025</strong></p><p><strong>Levels L through O</strong> cover specific disabilities and situations.</p><p><a href="#how-we-assign-smc-levels-l-thr">Learn how we assign SMC levels L through O</a></p><p><strong>Level R</strong> may apply if you need daily help from another person for basic needs (like dressing, eating, and bathing).</p><p><strong>Level S</strong> may apply if you can’t leave the house because of your service-connected disabilities.</p></div></div><div id="5901ada9-187e-4277-bf3a-8d1c853908e5" data-template="paragraphs/collapsible_panel" data-paragraph-type="paragraph--collapsible_panel" data-entity-id="187404"><va-accordion><va-accordion-item class="va-accordion-item" id="smc-l-through-smc-n-389c2a0b-cbe8-4e3e-9bd1-c796442ba37a"><h3 slot="headline">SMC-L through SMC-N</h3><div id="389c2a0b-cbe8-4e3e-9bd1-c796442ba37a" data-template="paragraphs/collapsible_panel__panel" data-paragraph-type="paragraph--collapsible_panel_item" data-entity-id="191194" data-analytics-faq-text="SMC-L through SMC-N"><div id="collapsible_panel_item-191194"><div itemProp="text"><p>Start with the <strong>Basic SMC rates</strong> table. Find the dependent status in the left column that best describes you. Then find your SMC letter designation in the top row. Your monthly basic rate is where your dependent status and SMC letter meet.</p><p>If you have more than 1 child or your spouse receives&nbsp;Aid and Attendance benefits,<strong>&nbsp;</strong>be sure to also check the&nbsp;<strong>Added amounts</strong>&nbsp;table,&nbsp;and add these to your amount from the&nbsp;<strong>Basic SMC rates</strong>&nbsp;table.</p><p><a href="/pension/aid-attendance-housebound" data-entity-type="node" data-entity-uuid="131d0c40-3680-4001-881e-e621eeae7337" data-entity-substitution="canonical" hreflang="en" title="VA Aid and Attendance benefits and Housebound allowance">Learn more about Aid and Attendance benefits</a></p></div><va-table table-title="Basic SMC rates" table-type="bordered"><va-table-row slot="headers"><span>Dependent status</span><span>SMC-L (in&nbsp;U.S.&nbsp;$)</span><span>SMC-L 1/2 (in&nbsp;U.S.&nbsp;$)</span><span>SMC-M (in&nbsp;U.S.&nbsp;$)</span><span>SMC-M 1/2 (in&nbsp;U.S.&nbsp;$)</span><span>SMC-N (in&nbsp;U.S.&nbsp;$)</span></va-table-row><va-table-row slot=""><span><strong>Veteran with 1 child</strong><p>(no spouse or parents)</p></span><span>5,047.68</span><span>5,300.85</span><span>5,555.40</span><span>5,926.85</span><span>6,299.49</span></va-table-row><va-table-row slot=""><span><strong>With 1 child and spouse</strong><p>(no parents)</p></span><span>5,281.24</span><span>5,534.41</span><span>5,788.96</span><span>6,160.41</span><span>6,533.05</span></va-table-row><va-table-row slot=""><span><strong>With 1 child, spouse, and 1 parent</strong><p></p></span><span>5,457.48</span><span>5,710.65</span><span>5,965.20</span><span>6,336.65</span><span>6,709.29</span></va-table-row><va-table-row slot=""><span><strong>With 1 child, spouse, and 2 parents</strong><p></p></span><span>5,633.72</span><span>5,886.89</span><span>6,141.44</span><span>6,512.89</span><span>6,885.53</span></va-table-row><va-table-row slot=""><span><strong>With 1 child and 1 parent</strong><p>(no spouse)</p></span><span>5,223.92</span><span>5,477.09</span><span>5,731.64</span><span>6,103.09</span><span>6,475.73</span></va-table-row><va-table-row slot=""><span><strong>With 1 child and 2 parents</strong><p>(no spouse)</p></span><span>5,400.16</span><span>5,653.33</span><span>5,907.88</span><span>6,279.33</span><span>6,651.97</span></va-table-row></va-table><va-table table-title="Added amounts" table-type="bordered"><va-table-row slot="headers"><span>Dependent status</span><span>SMC-L (in&nbsp;U.S.&nbsp;$)</span><span>SMC-L 1/2 (in&nbsp;U.S.&nbsp;$)</span><span>SMC-M (in&nbsp;U.S.&nbsp;$)</span><span>SMC-M 1/2 (in&nbsp;U.S.&nbsp;$)</span><span>SMC-N (in&nbsp;U.S.&nbsp;$)</span></va-table-row><va-table-row slot=""><span><strong>Each additional child under age 18</strong></span><span>109.11</span><span>109.11</span><span>109.11</span><span>109.11</span><span>109.11</span></va-table-row><va-table-row slot=""><span><strong>Each additional child over age 18 in a qualifying school program</strong></span><span>352.45</span><span>352.45</span><span>352.45</span><span>352.45</span><span>352.45</span></va-table-row><va-table-row slot=""><span><strong>Spouse receiving Aid and Attendance</strong></span><span>201.41</span><span>201.41</span><span>201.41</span><span>201.41</span><span>201.41</span></va-table-row></va-table></div></div></va-accordion-item><va-accordion-item class="va-accordion-item" id="smc-n-12-through-smc-s-ea6d3746-4040-49c9-904d-eca6eac45b83"><h3 slot="headline">SMC-N 1/2 through SMC-S</h3><div id="ea6d3746-4040-49c9-904d-eca6eac45b83" data-template="paragraphs/collapsible_panel__panel" data-paragraph-type="paragraph--collapsible_panel_item" data-entity-id="191198" data-analytics-faq-text="SMC-N 1/2 through SMC-S"><div id="collapsible_panel_item-191198"><div itemProp="text"><p>Start with the <strong>Basic SMC rates</strong> table. Find the dependent status in the left column that best describes you. Then find your SMC letter designation in the top row. Your monthly basic rate is where your dependent status and SMC letter meet.</p><p>If you have more than 1 child or your spouse receives&nbsp;Aid and Attendance benefits,<strong>&nbsp;</strong>be sure to also check the&nbsp;<strong>Added amounts</strong>&nbsp;table,&nbsp;and add these to your amount from the&nbsp;<strong>Basic SMC rates</strong>&nbsp;table.</p><p><a href="/pension/aid-attendance-housebound" data-entity-type="node" data-entity-uuid="131d0c40-3680-4001-881e-e621eeae7337" data-entity-substitution="canonical" hreflang="en" title="VA Aid and Attendance benefits and Housebound allowance">Learn more about Aid and Attendance benefits</a></p></div><va-table table-title="Basic SMC rates" table-type="bordered"><va-table-row slot="headers"><span>Dependent status</span><span>SMC-N 1/2 (in&nbsp;U.S.&nbsp;$)</span><span>SMC-O/P (in&nbsp;U.S.&nbsp;$)</span><span>SMC-R.1 (in&nbsp;U.S.&nbsp;$)</span><span>SMC-R.2/T (in&nbsp;U.S.&nbsp;$)</span><span>SMC-S (in&nbsp;U.S.&nbsp;$)</span></va-table-row><va-table-row slot=""><span><strong>Veteran with 1 child</strong><p>(no spouse or parents)</p></span><span>6,660.85</span><span>7,023.97</span><span>9,973.73</span><span>11,418.52</span><span>4,555.38</span></va-table-row><va-table-row slot=""><span><strong>With 1 child and spouse</strong><p>(no parents)</p></span><span>6,894.41</span><span>7,257.53</span><span>10,207.29</span><span>11,652.08</span><span>4,788.94</span></va-table-row><va-table-row slot=""><span><strong>With 1 child, spouse, and 1 parent</strong><p></p></span><span>7,070.65</span><span>7,433.77</span><span>10,383.53</span><span>11,828.32</span><span>4,965.18</span></va-table-row><va-table-row slot=""><span><strong>With 1 child, spouse, and 2 parents</strong><p></p></span><span>7,246.89</span><span>7,610.01</span><span>10,559.77</span><span>12,004.56</span><span>5,141.42</span></va-table-row><va-table-row slot=""><span><strong>With 1 child and 1 parent</strong><p>(no spouse)</p></span><span>6,837.09</span><span>7,200.21</span><span>10,149.97</span><span>11,594.76</span><span>4,731.62</span></va-table-row><va-table-row slot=""><span><strong>With 1 child and 2 parents</strong><p>(no spouse)</p></span><span>7,013.33</span><span>7,376.45</span><span>10,326.21</span><span>11,771.00</span><span>4,907.86</span></va-table-row></va-table><va-table table-title="Added amounts" table-type="bordered"><va-table-row slot="headers"><span>Dependent status</span><span>SMC-N 1/2 (in&nbsp;U.S.&nbsp;$)</span><span>SMC-O/P (in&nbsp;U.S.&nbsp;$)</span><span>SMC-R.1 (in&nbsp;U.S.&nbsp;$)</span><span>SMC-R.2/T (in&nbsp;U.S.&nbsp;$)</span><span>SMC-S (in&nbsp;U.S.&nbsp;$)</span></va-table-row><va-table-row slot=""><span><strong>Each additional child under age 18</strong></span><span>109.11</span><span>109.11</span><span>109.11</span><span>109.11</span><span>109.11</span></va-table-row><va-table-row slot=""><span><strong>Each additional child over age 18 in a qualifying school program</strong></span><span>352.45</span><span>352.45</span><span>352.45</span><span>352.45</span><span>352.45</span></va-table-row><va-table-row slot=""><span><strong>Spouse receiving Aid and Attendance</strong></span><span>201.41</span><span>201.41</span><span>201.41</span><span>201.41</span><span>201.41</span></va-table-row></va-table></div></div></va-accordion-item></va-accordion></div><div data-template="paragraphs/wysiwyg" data-paragraph-type="paragraph--wysiwyg"><div itemProp="text"><p><strong>Note: </strong>We’re required by law to match the percentage of cost-of-living adjustments made to Social Security benefits. These adjustments help to make sure that the purchasing power of your benefits keeps up with inflation.</p><p><a href="https://www.ssa.gov/cola/" hreflang="en" target="_blank">Get the latest cost-of-living adjustment (COLA) information on the Social Security Administration’s (SSA) website</a></p><h2 id="how-to-use-the-tables-to-find-">How to use the tables to find your monthly payment</h2><h3>Find your basic rate</h3><p>Go to the SMC rate&nbsp;that applies&nbsp;to you. On the <strong>Basic SMC</strong> rates table, find the amount for your disability rating and SMC letter designation. This is your monthly basic rate.</p><p><strong>Example (Veteran with no children):</strong> If you were a Veteran with a dependent spouse (no dependent parents or children), and you had an SMC-M designation, your monthly basic rate would be <strong>$5,628.14 </strong>each month.</p><h3>Find your added amounts, if any apply</h3><p>If your spouse receives Aid and Attendance benefits or you have more than 1 child, you may qualify for additional monthly payment amounts as listed in the <strong>Added amounts</strong> table.</p><p><a href="/pension/aid-attendance-housebound" data-entity-type="node" data-entity-uuid="131d0c40-3680-4001-881e-e621eeae7337" data-entity-substitution="canonical" hreflang="en" title="VA Aid and Attendance benefits and Housebound allowance">Learn more about Aid and Attendance benefits</a></p><p>First, determine your basic rate.</p><p><strong>Example (Veteran with children):</strong> If you’re a Veteran with an SMC-L designation, and you have 4 dependent children (1 child over age 18 in a qualifying school program and 3 children under age 18), and a dependent spouse, you would start with a basic SMC rate of <strong>$5,281.24</strong> for a Veteran with 1 child and spouse (no parents).</p><p>Next, look at the <strong>Added amounts</strong> table. Find the amount for children under age 18 (<strong>$109.11</strong>).</p><p>Since your basic rate already provides payment for 1 child, you would add the rate of <strong>$109.11&nbsp;</strong>for each additional child under age 18 (so <strong>$109.11&nbsp;</strong>x 2).</p><p>Then, look for the rate for each additional child over 18 in a qualifying school program (<strong>$352.45</strong>).</p><p>If your spouse receives Aid and Attendance, you would also add <strong>$201.41&nbsp;</strong>(which is the added amount for a spouse receiving Aid and Attendance, for a Veteran with an SMC-L designation).</p><p>Add these amounts to your basic rate to get your total monthly payment amount.</p><p>In our example of a Veteran with an SMC-L designation, your total monthly payment amount would be:</p><p><strong>$5,281.24 </strong>(basic rate (1 spouse, 1 child)<br><strong>+ 109.11 </strong>(second child under 18)<br><strong>+ 109.11 </strong>(third child under 18)<br><strong>+ 352.45&nbsp;</strong>(1 child over 18, in a qualifying school program)<br><strong>+ 201.41 </strong>(spouse who receives Aid and Attendance)<br><strong>Total: $6,053.32</strong></p><hr><h2 id="how-we-assign-smc-levels-l-thr">How we assign SMC levels L through O</h2><p><strong>We assign SMC levels based on very specific situations and combinations of situations, including:</strong></p><ul><li>The amputation of 1 or more limbs or extremities</li><li>The loss of use of 1 or more limbs or extremities (meaning you have no effective function remaining)</li><li>The physical loss of 1 or both eyes</li><li>The loss of sight or total blindness in 1 or both eyes</li><li>Being permanently bedridden (unable to get out of bed)</li><li>Needing daily help with basic needs (like eating, dressing, and bathing), also called “Aid and Attendance”</li></ul><p>Select an SMC letter below to learn more about the specific situations and combinations of situations that fall within that designation.</p></div></div><div id="ebf176d8-e43e-44b6-a580-3198330f8e1b" data-template="paragraphs/collapsible_panel" data-paragraph-type="paragraph--collapsible_panel" data-entity-id="187412"><va-accordion><va-accordion-item class="va-accordion-item" id="smc-l-73b005d3-d41c-4e22-90b8-1d9cbfb1b19d"><h3 slot="headline">SMC-L</h3><div id="73b005d3-d41c-4e22-90b8-1d9cbfb1b19d" data-template="paragraphs/collapsible_panel__panel" data-paragraph-type="paragraph--collapsible_panel_item" data-entity-id="191202" data-analytics-faq-text="SMC-L"><div id="collapsible_panel_item-191202"><div itemProp="text"><p><strong>You may receive an SMC-L designation if any of these situations are true for you:</strong></p><ul><li>You’ve had both feet amputated, <strong>or</strong></li><li>You’ve had 1 foot amputated, and have lost the use of the other foot, <strong>or</strong></li><li>You’ve had 1 hand and 1 foot amputated, <strong>or</strong></li><li>You’ve had 1 foot amputated, and have lost the use of 1 hand, <strong>or</strong></li><li>You’ve had 1 hand amputated, and have lost the use of 1 foot</li></ul><p><strong>Or:</strong></p><ul><li>You’ve lost the use of both feet, <strong>or</strong></li><li>You’ve lost the use of 1 hand and 1 foot</li></ul><p><strong>Or:</strong></p><ul><li>You’ve lost sight in both eyes (blindness), <strong>or</strong></li><li>You’re permanently bedridden, <strong>or</strong></li><li>You need daily help with basic needs (like eating, dressing, and bathing)</li></ul></div></div></div></va-accordion-item><va-accordion-item class="va-accordion-item" id="smc-l-12-d31dfcb7-323b-44fd-b0a3-46a22d89f3f1"><h3 slot="headline">SMC-L 1/2</h3><div id="d31dfcb7-323b-44fd-b0a3-46a22d89f3f1" data-template="paragraphs/collapsible_panel__panel" data-paragraph-type="paragraph--collapsible_panel_item" data-entity-id="191206" data-analytics-faq-text="SMC-L 1/2"><div id="collapsible_panel_item-191206"><div itemProp="text"><p><strong>You may receive an SMC-L 1/2 designation if any of these situations are true for you:</strong></p><ul><li>You’ve had 1 foot and the other knee amputated, <strong>or</strong></li><li>You’ve had 1 foot amputated, and have lost the use of the other knee, <strong>or</strong></li><li>You’ve had 1 foot and 1 elbow amputated, <strong>or</strong></li><li>You’ve had 1 foot amputated, and have lost the use of 1 elbow, <strong>or</strong></li><li>You’ve had 1 knee and 1 hand amputated, <strong>or</strong></li><li>You’ve had 1 knee amputated, and have lost the use of 1 hand</li></ul><p><strong>Or:</strong></p><ul><li>You’ve lost the use of 1 foot, and have had the other knee amputated, <strong>or</strong></li><li>You’ve lost the use of 1 foot, and have had 1 elbow amputated, <strong>or</strong></li><li>You’ve lost the use of 1 foot and 1 elbow, <strong>or</strong></li><li>You’ve lost the use of 1 knee, and have had 1 hand amputated, <strong>or</strong></li><li>You’ve lost the use of 1 knee and 1 hand</li></ul><p><strong>Or:</strong></p><ul><li>You have blindness in 1 eye and total blindness in the other eye with only the ability to perceive light, <strong>or</strong></li><li>You have blindness in both eyes, and have lost the use of 1 foot (rated as less than 50% disabling), <strong>or</strong></li><li>You have blindness in both eyes, and have total deafness in 1 ear</li></ul><p><strong>Or both of these are true:</strong></p><ul><li>You have a disability or situation listed in the SMC-L designation, <strong>and</strong></li><li>You have 1 or more additional permanent disabilities rated as 50% or more disabling</li></ul></div></div></div></va-accordion-item><va-accordion-item class="va-accordion-item" id="smc-m-6ed92038-d672-4ef1-ae26-c95535b97c4a"><h3 slot="headline">SMC-M</h3><div id="6ed92038-d672-4ef1-ae26-c95535b97c4a" data-template="paragraphs/collapsible_panel__panel" data-paragraph-type="paragraph--collapsible_panel_item" data-entity-id="191210" data-analytics-faq-text="SMC-M"><div id="collapsible_panel_item-191210"><div itemProp="text"><p><strong>You may receive an SMC-M designation if any of these situations are true for you:</strong></p><ul><li>You’ve had both hands amputated, <strong>or</strong></li><li>You’ve had 1 hand amputated, and have lost the use of the other hand, <strong>or</strong></li><li>You’ve had both knees amputated, <strong>or</strong></li><li>You’ve had 1 elbow and 1 knee amputated, <strong>or</strong></li><li>You’ve had 1 foot amputated, and have lost the use of 1 arm at the shoulder, <strong>or</strong></li><li>You’ve had 1 foot amputated, and have had 1 leg amputated so close to the hip that you can’t wear a prosthesis, <strong>or</strong></li><li>You’ve had 1 foot amputated, and have had 1 arm amputated so close to the shoulder that you can’t wear a prosthesis, <strong>or</strong></li><li>You’ve had 1 hand amputated, and have had 1 leg amputated so close to the hip that you can’t wear a prosthesis</li></ul><p><strong>Or:</strong></p><ul><li>You’ve lost the use of both hands, <strong>or</strong></li><li>You’ve lost the use of both knees, <strong>or</strong></li><li>You’ve lost the use of 1 elbow and 1 knee, <strong>or</strong></li><li>You’ve lost the use of 1 foot and the use of 1 arm at the shoulder, <strong>or</strong></li><li>You’ve lost the use of 1 foot, and have had 1 leg amputated so close to the hip that you can’t wear a prosthesis, <strong>or</strong></li><li>You’ve lost the use of 1 foot, and have had 1 arm amputated so close to the shoulder that you can’t wear a prosthesis, <strong>or</strong></li><li>You’ve lost the use of 1 hand, and have had 1 leg amputated so close to the hip that you can’t wear a prosthesis</li></ul><p><strong>Or you have blindness in 1 eye, and:</strong></p><ul><li>You’ve physically lost the other eye, <strong>or</strong></li><li>You have total blindness without the ability to perceive light in the other eye, <strong>or</strong></li><li>You have total blindness in the other eye with only the ability to perceive light, and have total deafness in 1 ear, <strong>or</strong></li><li>You have total blindness in the other eye with only the ability to perceive light, and have lost the use of 1 foot (rated as less than 50% disabling)</li></ul><p><strong>Or:</strong></p><ul><li>You have blindness in both eyes that’s considered total blindness, with only the ability to perceive light, <strong>or</strong></li><li>You have blindness in both eyes that requires you to have daily help with basic needs (like eating, dressing, and bathing)</li></ul><p><strong>Or you have blindness in both eyes, and:</strong></p><ul><li>You have deafness in both ears (rated as 30% or more disabling),<strong> or</strong></li><li>You’ve had 1 hand amputated, <strong>or</strong></li><li>You’ve lost the use of 1 hand,<strong> or</strong></li><li>You’ve had 1 foot amputated, <strong>or</strong></li><li>You’ve lost the use of 1 foot (rated as 50% or more disabling)</li></ul></div></div></div></va-accordion-item><va-accordion-item class="va-accordion-item" id="smc-m-12-64387090-4058-49e6-8dc9-448caa9449a7"><h3 slot="headline">SMC-M 1/2</h3><div id="64387090-4058-49e6-8dc9-448caa9449a7" data-template="paragraphs/collapsible_panel__panel" data-paragraph-type="paragraph--collapsible_panel_item" data-entity-id="191214" data-analytics-faq-text="SMC-M 1/2"><div id="collapsible_panel_item-191214"><div itemProp="text"><p><strong>You may receive an SMC-M 1/2 designation if any of these situations are true for you:</strong></p><ul><li>You’ve had&nbsp;1 knee amputated, and have had 1 leg amputated so close to the hip that you can’t wear a prosthesis, <strong>or</strong></li><li>You’ve had 1 knee amputated, and have had 1 arm amputated so close to the shoulder that you can’t wear a prosthesis, <strong>or</strong></li><li>You’ve had 1 elbow amputated, and have had 1 leg amputated so close to the hip that you can’t wear a prosthesis, <strong>or</strong></li><li>You’ve had 1 hand and 1 elbow amputated, <strong>or</strong></li><li>You’ve had 1 hand amputated, and have lost the use of 1 elbow</li></ul><p><strong>Or:</strong></p><ul><li>You’ve lost the use of 1 knee, and have had 1 leg amputated so close to the hip that you can’t wear a prosthesis, <strong>or</strong></li><li>You’ve lost the use of 1 knee, and have had 1 arm amputated so close to the shoulder that you can’t wear a prosthesis, <strong>or</strong></li><li>You’ve lost the use of 1 elbow, and have had 1 leg amputated so close to the hip that you can’t wear a prosthesis, <strong>or</strong></li><li>You’ve lost of use of 1 hand, and have had 1 elbow amputated, <strong>or</strong></li><li>You’ve lost the use of 1 hand and 1 elbow</li></ul><p><strong>Or you have total blindness with only the ability to perceive light:</strong></p><ul><li>In 1 eye, and have physically lost the other eye, <strong>or</strong></li><li>In 1 eye, and have total blindness without the ability to perceive light in the other eye, <strong>or</strong></li><li>In both eyes, and have lost the use of 1 foot (rated as less than 50% disabling)</li></ul><p><strong>Or you have blindness in 1 eye, and:</strong></p><ul><li>You’ve physically lost the other eye, and have total deafness in 1 ear, <strong>or</strong></li><li>You have total blindness without the ability to perceive light in the other eye, and have total deafness in 1 ear, <strong>or</strong></li><li>You have total blindness with only the ability to perceive light in the other eye, and have deafness in both ears (rated as 30% or more disabling), <strong>or</strong></li><li>You have total blindness with only the ability to perceive light in the other eye, and have had 1 foot amputated, <strong>or</strong></li><li>You have total blindness with only the ability to perceive light in the other eye, and have lost the use of 1 foot (rated as 50% or more disabling), <strong>or</strong></li><li>You have total blindness with only the ability to perceive light in the other eye, and have had 1 hand amputated, <strong>or</strong></li><li>You have total blindness with only the ability to perceive light in the other eye, and have lost the use of 1 hand</li></ul><p><strong>Or:</strong></p><ul><li>You have blindness in both eyes and total deafness in 1 ear, <strong>or</strong></li><li>You have blindness in both eyes that requires you to have daily help with basic needs (like eating, bathing, and dressing), and have lost the use of 1 foot (rated as less than 50% disabling)</li></ul><p><strong>Or both of these are true:</strong></p><ul><li>You have a disability or situation listed in the SMC-M designation, <strong>and</strong></li><li>You have 1 or more additional permanent disabilities rated as 50% or more disabling</li></ul></div></div></div></va-accordion-item><va-accordion-item class="va-accordion-item" id="smc-n-b616d1a7-b31b-4aac-9d16-f4b889eb9e7c"><h3 slot="headline">SMC-N</h3><div id="b616d1a7-b31b-4aac-9d16-f4b889eb9e7c" data-template="paragraphs/collapsible_panel__panel" data-paragraph-type="paragraph--collapsible_panel_item" data-entity-id="191218" data-analytics-faq-text="SMC-N"><div id="collapsible_panel_item-191218"><div itemProp="text"><p><strong>You may receive an SMC-N designation if any of these situations are true for you:</strong></p><ul><li>You’ve had both elbows amputated, <strong>or</strong></li><li>You’ve had both legs amputated so close to the hip that you can’t wear a prosthesis, <strong>or</strong></li><li>You’ve had 1 arm and 1 leg amputated so close to the shoulder and hip that you can’t wear a prosthesis on either, <strong>or</strong></li><li>You’ve had 1 hand amputated and the other arm amputated so close to the shoulder that you can’t wear a prosthesis</li></ul><p><strong>Or:</strong></p><ul><li>You’ve lost the use of both elbows, <strong>or</strong></li><li>You’ve lost the use of 1 hand, and have had the other arm amputated so close to the shoulder that you can’t wear a prosthesis</li></ul><p><strong>Or:</strong></p><ul><li>You’ve physically lost both eyes, <strong>or</strong></li><li>You have total blindness without the ability to perceive light</li></ul><p><strong>Or you have total blindness with only the ability to perceive light in 1 eye, and:</strong></p><ul><li>You’ve physically lost the other eye, and have deafness in both ears (rated as 10% or 20% disabling), <strong>or</strong></li><li>You have total blindness without the ability to perceive light in the other eye, and have deafness in both ears (rated as 10% or 20% disabling), <strong>or</strong></li><li>You’ve physically lost the other eye, and have lost the use of 1 foot (rated as less than 50% disabling), <strong>or</strong></li><li>You have total blindness without the ability to perceive light in the other eye, and have lost the use of 1 foot (rated as less than 50% disabling)</li></ul><p><strong>Or you have total blindness with only the ability to perceive light in both eyes, and:</strong></p><ul><li>You have deafness in both ears (rated as 30% or more disabling), <strong>or</strong></li><li>You’ve had 1 hand amputated, <strong>or</strong></li><li>You’ve lost the use of 1 foot, <strong>or</strong></li><li>You’ve lost the use of 1 hand, <strong>or</strong></li><li>You’ve had 1 foot amputated, <strong>or</strong></li><li>You’ve lost the use of 1 foot (rated as 50% or more disabling)</li></ul><p><strong>Or you have blindness in 1 eye, and:</strong></p><ul><li>You’ve physically lost the other eye, and have deafness in both ears (rated as 30% or more disabling), <strong>or</strong></li><li>You have total blindness without the ability to perceive light in the other eye, and have deafness in both ears (rated as 30% or more disabling)</li></ul><p><strong>Or you have blindness in both eyes that requires you to have daily help with basic needs (like dressing, eating, or bathing), and:</strong></p><ul><li>You have deafness in both ears (rated as 30% or more disabling), <strong>or</strong></li><li>You’ve had 1 hand amputated, <strong>or</strong></li><li>You’ve lost the use of 1 hand, <strong>or</strong></li><li>You’ve had 1 foot amputated, <strong>or</strong></li><li>You’ve lost the use of 1 foot (rated as 50% disabling)</li></ul></div></div></div></va-accordion-item><va-accordion-item class="va-accordion-item" id="smc-n-12-dafc74f9-5ca5-480d-9a76-b17e600fa509"><h3 slot="headline">SMC-N 1/2</h3><div id="dafc74f9-5ca5-480d-9a76-b17e600fa509" data-template="paragraphs/collapsible_panel__panel" data-paragraph-type="paragraph--collapsible_panel_item" data-entity-id="191222" data-analytics-faq-text="SMC-N 1/2"><div id="collapsible_panel_item-191222"><div itemProp="text"><p><strong>You may receive an SMC-N 1/2 designation if any of these situations are true for you:</strong></p><ul><li>You’ve had 1 elbow amputated, and have had 1 arm amputated so close to the shoulder that you can’t wear a prosthesis, <strong>or</strong></li><li>You’ve lost the use of 1 elbow, and have had 1 arm amputated so close to the shoulder that you can’t wear a prosthesis, <strong>or</strong></li><li>You’ve physically lost both eyes, and have lost the use of 1 foot (rated as less than 50% disabling), <strong>or</strong></li><li>You have total blindness without the ability to see light, and have lost the use of 1 foot (rated as less than 50%)</li></ul><p><strong>Or you have total blindness with only the ability to perceive light in 1 eye, have physically lost the other eye, and:</strong></p><ul><li>You have deafness in both ears (rated as 30% or more disabling), <strong>or</strong></li><li>You’ve had 1 foot amputated, <strong>or</strong></li><li>You’ve lost the use of 1 foot (rated as 50% or more disabling), <strong>or</strong></li><li>You’ve had 1 hand amputated, <strong>or</strong></li><li>You’ve lost the use of 1 hand</li></ul><p><strong>Or you have total blindness with only the ability to perceive light in 1 eye and total blindness without the ability to perceive light in the other eye, and:</strong></p><ul><li>You have deafness in both ears (rated as 30% or more disabling), <strong>or</strong></li><li>You’ve had 1 foot amputated, <strong>or</strong></li><li>You’ve lost the use of 1 foot (rated as 50% or more disabling), <strong>or</strong></li><li>You’ve had 1 hand amputated, <strong>or</strong></li><li>You’ve lost the use of 1 hand</li></ul><p><strong>Or both of these are true:&nbsp;</strong></p><ul><li>You have a disability or situation listed in the SMC-N designation, <strong>and</strong></li><li>You have 1 or more additional permanent disabilities rated as 50% or more disabling</li></ul></div></div></div></va-accordion-item><va-accordion-item class="va-accordion-item" id="smc-o-66c24764-1287-434a-a4e5-f061e37f19d6"><h3 slot="headline">SMC-O</h3><div id="66c24764-1287-434a-a4e5-f061e37f19d6" data-template="paragraphs/collapsible_panel__panel" data-paragraph-type="paragraph--collapsible_panel_item" data-entity-id="191226" data-analytics-faq-text="SMC-O"><div id="collapsible_panel_item-191226"><div itemProp="text"><p><strong>You may receive an SMC-O designation if any of these situations are true for you:</strong></p><ul><li>You’ve had both arms amputated so close to the shoulder that you can’t wear a prosthesis, <strong>or</strong></li><li>You have complete paralysis of both legs that’s resulted in being unable to control your bladder and bowels</li></ul><p><strong>Or:</strong></p><ul><li>You have hearing loss in both ears (with at least 1 ear’s deafness caused by military service) that’s rated as 60% or more disabling, and you have blindness in both eyes, <strong>or</strong></li><li>You have hearing loss in both ears (with at least 1 ear’s deafness caused by military service) that’s rated as 40% or more disabling, and you have blindness in both eyes with only the ability to perceive light, <strong>or</strong></li><li>You have total deafness in 1 ear as well as blindness in both eyes with only the ability to perceive light</li></ul><p><strong>Or you have total blindness without the ability to see light, and:</strong></p><ul><li>You have deafness in both ears (rated as 30% or more disabling), <strong>or</strong></li><li>You’ve had 1 foot amputated, <strong>or</strong></li><li>You’ve lost the use of 1 foot (rated as 50% or more disabling), <strong>or</strong></li><li>You’ve had 1 hand amputated, <strong>or</strong></li><li>You’ve lost the use of 1 hand</li></ul><p><strong>Or you have physically lost both eyes, and:</strong></p><ul><li>You have deafness in both ears (rated as 30% or more disabling), <strong>or</strong></li><li>You’ve had 1 foot amputated, <strong>or</strong></li><li>You’ve lost the use of 1 foot (rated as 50% or more disabling), <strong>or</strong></li><li>You’ve had 1 hand amputated, <strong>or</strong></li><li>You’ve lost the use of 1 hand</li></ul><p><strong>Or you have 2 different disabilities or situations listed in the SMC-L, SMC-M, or SMC-N designations.</strong></p></div></div></div></va-accordion-item></va-accordion></div><div data-template="paragraphs/wysiwyg" data-paragraph-type="paragraph--wysiwyg"><div itemProp="text"><h2 id="past-rates">Past rates</h2><p>Review special monthly compensation rates for past years.</p><p><a href="/disability/compensation-rates/special-monthly-compensation-rates/past-rates-2025" data-entity-type="node" data-entity-uuid="2f2641f8-235a-4dce-b4d8-18f2b62895bd" data-entity-substitution="canonical" title="Past rates: 2025 VA special monthly compensation rates">2025 rates</a> (effective December 1, 2024)<br><a href="/disability/compensation-rates/special-monthly-compensation-rates/past-rates-2024" data-entity-type="node" data-entity-uuid="26ecb13d-275e-4808-a1b5-db3ade727034" data-entity-substitution="canonical" title="Past rates: 2024 VA special monthly compensation rates">2024 rates</a> (effective December 1, 2023)<br><a href="/disability/compensation-rates/special-monthly-compensation-rates/past-rates-2023" data-entity-type="node" data-entity-uuid="aadc6f25-2e77-458d-bdaa-95a0938a3c02" data-entity-substitution="canonical" title="Past rates: 2023 VA special monthly compensation rates">2023 rates</a> (effective December 1, 2022)</p></div></div><div class="va-nav-linkslist va-nav-linkslist--related"><section data-template="paragraphs/list_of_link_teasers" data-entity-id="2e0751f3-cd28-420e-bd07-008366cb4e93"><h2 id="information-to-help-you-manage-your-benefits" class="vads-u-border-bottom--1px vads-u-border-color--base-light vads-u-margin--0 vads-u-padding-top--2 vads-u-padding-bottom--0p5">Information to help you manage your benefits</h2><ul class="usa-unstyled-list"><li class="vads-u-margin-y--2" data-template="paragraphs/linkTeaser" data-entity-id="e3534961-7fe2-4f40-905c-ed08522b10c6" data-links-list-header="File for a VA disability increase" data-links-list-section-header="Information to help you manage your benefits"><p class="vads-u-margin--0 vads-u-font-weight--bold"><va-link href="/disability/how-to-file-claim/" target="" text="File for a VA disability increase"></va-link></p><p class="vads-u-margin--0">If your service-connected disability has gotten worse, find out how to file a claim to increase your disability rating.</p></li><li class="vads-u-margin-y--2" data-template="paragraphs/linkTeaser" data-entity-id="bb418ecb-7ec4-4a23-85fc-6b1b200c1dbc" data-links-list-header="View or change dependents on your VA disability benefits" data-links-list-section-header="Information to help you manage your benefits"><p class="vads-u-margin--0 vads-u-font-weight--bold"><va-link href="/manage-dependents/" target="" text="View or change dependents on your VA disability benefits"></va-link></p><p class="vads-u-margin--0">Find out how and when to add a dependent spouse, child, or parent to your VA disability benefits. Also learn how to remove a dependent from your benefits.</p></li><li class="vads-u-margin-y--2" data-template="paragraphs/linkTeaser" data-entity-id="d1425b2f-828f-4fc2-bb30-bc7d936c3082" data-links-list-header="Change your VA direct deposit and contact information" data-links-list-section-header="Information to help you manage your benefits"><p class="vads-u-margin--0 vads-u-font-weight--bold"><va-link href="/change-direct-deposit/" target="" text="Change your VA direct deposit and contact information"></va-link></p><p class="vads-u-margin--0">Find out how to change your information online.</p></li><li class="vads-u-margin-y--2" data-template="paragraphs/linkTeaser" data-entity-id="25254f03-8bf8-4f77-989c-b10fb7819882" data-links-list-header="View your disability payments history" data-links-list-section-header="Information to help you manage your benefits"><p class="vads-u-margin--0 vads-u-font-weight--bold"><va-link href="/va-payment-history/" target="" text="View your disability payments history"></va-link></p><p class="vads-u-margin--0">Check the status of your VA disability and pension payments. You can also review certain survivor benefits.</p></li></ul></section></div><va-back-to-top></va-back-to-top><div data-testid="content-footer" class="last-updated "><div class="mobile-lg:vads-u-display--flex above-footer-elements-container"><div class="vads-u-flex--auto"><span class="vads-u-text-align--justify"><p>Last updated: <time dateTime="2025-12-03">December 3, 2025</time></p></span></div><div class="vads-u-flex--1 vads-u-text-align--right"><va-button id="mdFormButton" disable-analytics="" secondary="" class="vads-u-background-color--white" text="Feedback"></va-button></div></div></div></article></div></div></div></div></div></main><footer class="footer"><div id="footerNav" data-testid="footer" data-minimal-footer="false"></div></footer><div id="logout-modal-root"></div></div><script id="__NEXT_DATA__" type="application/json" nonce="joUkePSrxGnOWOLB4psiirriJPpuFzvk">{"props":{"pageProps":{"previewTokenError":false,"preview":false,"serializedResource":{"data":{"id":"6c84b5b0-bcb1-4b61-a9af-d882fbe50408","entityId":991,"entityPath":"/disability/compensation-rates/special-monthly-compensation-rates","type":"node--page","published":true,"moderationState":"published","title":"Current special monthly compensation rates","metatags":[{"tag":"meta","attributes":{"name":"title","content":"Current special monthly compensation rates | Veterans Affairs"}},{"tag":"meta","attributes":{"name":"description","content":"VA special monthly compensation (SMC) is a higher rate of compensation that we pay to Veterans as well as their spouses, surviving spouses, and parents with certain needs or disabilities. Find the 2026 special monthly compensation rates that may apply to you."}},{"tag":"link","attributes":{"rel":"image_src","href":"https://www.va.gov/img/design/logo/va-og-image.png"}},{"tag":"meta","attributes":{"property":"og:site_name","content":"Veterans Affairs"}},{"tag":"meta","attributes":{"property":"og:title","content":"Current special monthly compensation rates | Veterans Affairs"}},{"tag":"meta","attributes":{"property":"og:description","content":"VA special monthly compensation (SMC) is a higher rate of compensation that we pay to Veterans as well as their spouses, surviving spouses, and parents with certain needs or disabilities. Find the 2026 special monthly compensation rates that may apply to you."}},{"tag":"meta","attributes":{"property":"og:image","content":"https://www.va.gov/img/design/logo/va-og-image.png"}},{"tag":"meta","attributes":{"property":"og:image:alt","content":"U.S. Department of Veterans Affairs"}},{"tag":"meta","attributes":{"name":"twitter:card","content":"summary_large_image"}},{"tag":"meta","attributes":{"name":"twitter:description","content":"VA special monthly compensation (SMC) is a higher rate of compensation that we pay to Veterans as well as their spouses, surviving spouses, and parents with certain needs or disabilities. Find the 2026 special monthly compensation rates that may apply to you."}},{"tag":"meta","attributes":{"name":"twitter:site","content":"@DeptVetAffairs"}},{"tag":"meta","attributes":{"name":"twitter:title","content":"Current special monthly compensation rates | Veterans Affairs"}},{"tag":"meta","attributes":{"name":"twitter:image","content":"https://www.va.gov/img/design/logo/va-og-image.png"}},{"tag":"meta","attributes":{"name":"twitter:image:alt","content":"U.S. Department of Veterans Affairs"}}],"breadcrumbs":[{"href":"/","label":"Home"},{"href":"/disability","label":"Disability benefits"},{"href":"/disability/compensation-rates","label":"Disability compensation rates"},{"href":"","label":"Current special monthly compensation rates"}],"lastUpdated":"2025-12-03T21:13:25+00:00","description":"VA special monthly compensation (SMC) is a higher rate of compensation that we pay to Veterans as well as their spouses, surviving spouses, and parents with certain needs or disabilities. Find the 2026 special monthly compensation rates that may apply to you.","introText":"\u003cp\u003eVA special monthly compensation (SMC) is a higher rate of compensation that we pay to Veterans as well as their spouses, surviving spouses, and parents with certain needs or disabilities. Find the 2026 special monthly compensation rates that may apply to you.\u003c/p\u003e\n","showTableOfContents":false,"alert":null,"featuredContent":[],"mainContent":[{"type":"paragraph--wysiwyg","id":"5a849792-bb87-48e8-849d-eb7c1f9bd6a8","html":"\u003ch2 id=\"special-monthly-compensation-r\"\u003eSpecial monthly compensation rate payment variations\u003c/h2\u003e\u003cp\u003e\u003cstrong\u003eEffective December 1, 2025\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eLevels K and Q\u003c/strong\u003e are special rates called SMC\u0026nbsp;rate payment variations. We may add Level K to your basic SMC rate.\u003c/p\u003e"},{"type":"paragraph--collapsible_panel","id":"7cea1dcf-dcf2-4332-a4f1-be570c38b674","entityId":187388,"paragraphs":[{"type":"paragraph--collapsible_panel_item","id":"85c3bf44-1cb2-4bc1-9700-8560a6674ca3","entityId":191182,"title":"SMC-K and SMC-Q rates","wysiwyg":null,"paragraphs":[{"type":"paragraph--table","id":"4133c027-c02f-4c89-bdd6-787ac89f4817","entityId":192661,"title":"SMC rate payment variations","data":[["SMC letter designation","Monthly payment (in\u0026nbsp;U.S.\u0026nbsp;$)","How this payment variation works"],["\u003cb\u003e SMC-K \u003c/b\u003e","139.87","If you qualify for SMC-K, we add this rate to your basic disability compensation rate for any disability rating from 0% to 100%. We also add this rate to all SMC basic rates except SMC-O, SMC-Q, and SMC-R. You may receive 1 to 3 SMC-K awards in addition to basic and SMC rates."],["\u003cb\u003e SMC-Q \u003c/b\u003e","67.00","This is a protected rate that we haven’t awarded since August 19, 1968. If we awarded you an SMC-Q designation, we pay this rate in place of your basic disability compensation rate."]]}]}],"bordered":false},{"type":"paragraph--wysiwyg","id":"3f640d86-50fe-47ba-ac1a-b13ea3a8398a","html":"\u003ch2 id=\"special-monthly-compensation-r\"\u003eSpecial monthly compensation rates for Veterans without children\u003c/h2\u003e\u003cp\u003e\u003cstrong\u003eEffective December 1, 2025\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eLevels L through O\u003c/strong\u003e cover specific disabilities and situations.\u003c/p\u003e\u003cp\u003e\u003ca href=\"#how-we-assign-smc-levels-l-thr\"\u003eLearn how we assign SMC levels L through O\u003c/a\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eLevel R\u003c/strong\u003e may apply if you need daily help from another person for basic needs (like dressing, eating, and bathing).\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eLevel S\u003c/strong\u003e may apply if you can’t leave the house because of your service-connected disabilities.\u003c/p\u003e"},{"type":"paragraph--collapsible_panel","id":"0a551c19-e87e-4406-b5af-8174821ee046","entityId":187396,"paragraphs":[{"type":"paragraph--collapsible_panel_item","id":"1447bb0c-6d12-49ac-8c1a-46ea03f372a5","entityId":191186,"title":"SMC-L through SMC-N rates","wysiwyg":"\u003cp\u003eStart with the \u003cstrong\u003eBasic SMC rates\u003c/strong\u003e table. Find the dependent status in the left column that best describes you. Then find your SMC letter designation in the top row. Your monthly basic rate is where your dependent status and SMC letter meet.\u003c/p\u003e\u003cp\u003eIf you have more than 1 child or your spouse receives\u0026nbsp;Aid and Attendance benefits,\u003cstrong\u003e\u0026nbsp;\u003c/strong\u003ebe sure to also check the\u0026nbsp;\u003cstrong\u003eAdded amounts\u003c/strong\u003e\u0026nbsp;table,\u0026nbsp;and add these to your amount from the\u0026nbsp;\u003cstrong\u003eBasic SMC rates\u003c/strong\u003e\u0026nbsp;table.\u003c/p\u003e\u003cp\u003e\u003ca href=\"/pension/aid-attendance-housebound\" data-entity-type=\"node\" data-entity-uuid=\"131d0c40-3680-4001-881e-e621eeae7337\" data-entity-substitution=\"canonical\" hreflang=\"en\" title=\"VA Aid and Attendance benefits and Housebound allowance\"\u003eLearn more about Aid and Attendance benefits\u003c/a\u003e\u003c/p\u003e","paragraphs":[{"type":"paragraph--table","id":"038d5ad4-15d4-4006-9674-0f5cea0c46fd","entityId":192665,"title":"Basic SMC rates","data":[["Dependent status","SMC-L (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-L 1/2 (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-M (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-M 1/2 (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-N (in\u0026nbsp;U.S.\u0026nbsp;$)"],["\u003cstrong\u003eVeteran alone\u003c/strong\u003e\u003cp\u003e(no dependents)\u003c/p\u003e","4,900.83","5,154.00","5,408.55","5,780.00","6,152.64"],["\u003cstrong\u003eWith spouse\u003c/strong\u003e\u003cp\u003e(no parents or children)\u003c/p\u003e","5,120.42","5,373.59","5,628.14","5,999.59","6,372.23"],["\u003cstrong\u003eWith spouse and 1 parent\u003c/strong\u003e\u003cp\u003e(no children)\u003c/p\u003e","5,296.66","5,549.83","5,804.38","6,175.83","6,548.47"],["\u003cstrong\u003eWith spouse and 2 parents\u003c/strong\u003e\u003cp\u003e(no children)\u003c/p\u003e","5,472.90","5,726.07","5,980.62","6,352.07","6,724.71"],["\u003cstrong\u003eWith 1 parent \u003c/strong\u003e\u003cp\u003e(no spouse or children)\u003c/p\u003e","5,077.07","5,330.24","5,584.79","5,956.24","6,328.88"],["\u003cstrong\u003eWith 2 parents\u003c/strong\u003e\u003cp\u003e(no spouse or children)\u003c/p\u003e","5,253.31","5,506.48","5,761.03","6,132.48","6,505.12"]]},{"type":"paragraph--table","id":"45bbae99-135f-4f54-bc70-6a852476da77","entityId":192669,"title":"Added amounts","data":[["Dependent status","SMC-L (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-L 1/2 (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-M (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-M\u0026nbsp;1/2 (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-N (in\u0026nbsp;U.S.\u0026nbsp;$)"],["\u003cstrong\u003eSpouse receiving Aid and Attendance\u003c/strong\u003e","201.41","201.41","201.41","201.41","201.41"]]}]},{"type":"paragraph--collapsible_panel_item","id":"d3792984-5c4a-4b76-b9bc-a5d754ad3a51","entityId":191190,"title":"SMC-N 1/2 through SMC-S","wysiwyg":"\u003cp\u003eStart with the \u003cstrong\u003eBasic SMC rates\u003c/strong\u003e table. Find the dependent status in the left column that best describes you. Then find your SMC letter designation in the top row. Your monthly basic rate is where your dependent status and SMC letter meet.\u003c/p\u003e\u003cp\u003eIf you have more than 1 child or your spouse receives\u0026nbsp;Aid and Attendance benefits,\u003cstrong\u003e\u0026nbsp;\u003c/strong\u003ebe sure to also check the\u0026nbsp;\u003cstrong\u003eAdded amounts\u003c/strong\u003e\u0026nbsp;table,\u0026nbsp;and add these to your amount from the\u0026nbsp;\u003cstrong\u003eBasic SMC rates\u003c/strong\u003e\u0026nbsp;table.\u003c/p\u003e\u003cp\u003e\u003ca href=\"/pension/aid-attendance-housebound\" data-entity-type=\"node\" data-entity-uuid=\"131d0c40-3680-4001-881e-e621eeae7337\" data-entity-substitution=\"canonical\" hreflang=\"en\" title=\"VA Aid and Attendance benefits and Housebound allowance\"\u003eLearn more about Aid and Attendance benefits\u003c/a\u003e\u003c/p\u003e","paragraphs":[{"type":"paragraph--table","id":"03ae0548-3f88-445e-b51c-44418703cbdb","entityId":192673,"title":"Basic SMC rates","data":[["Dependent status","SMC-N 1/2 (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-O/P (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-R.1 (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-R.2/T (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-S (in\u0026nbsp;U.S.\u0026nbsp;$)"],["\u003cstrong\u003eVeteran alone\u003c/strong\u003e\u003cp\u003e(no dependents)\u003c/p\u003e","6,514.00","6,877.12","9,826.88","11,271.67","4,408.53"],["\u003cstrong\u003eWith spouse\u003c/strong\u003e\u003cp\u003e(no parents or children)\u003c/p\u003e","6,733.59","7,096.71","10,046.47","11,491.26","4,628.12"],["\u003cstrong\u003eWith spouse and 1 parent\u003c/strong\u003e\u003cp\u003e(no children)\u003c/p\u003e","6,909.83","7,272.95","10,222.71","11,667.50","4,804.36"],["\u003cstrong\u003eWith spouse and 2 parents\u003c/strong\u003e\u003cp\u003e(no children)\u003c/p\u003e","7,086.07","7,449.19","10,398.95","11,843.74","4,980.60"],["\u003cstrong\u003eWith 1 parent\u003c/strong\u003e\u003cp\u003e(no spouse or children)\u003c/p\u003e","6,690.24","7,053.36","10,003.12","11,447.91","4,584.77"],["\u003cstrong\u003eWith 2 parents\u003c/strong\u003e\u003cp\u003e(no spouse or children)\u003c/p\u003e","6,866.48","7,229.60","10,179.36","11,624.15","4,761.01"]]},{"type":"paragraph--table","id":"76900b20-8448-4443-8776-6de8d06d491f","entityId":192677,"title":"Added amounts","data":[["Dependent status","SMC-N 1/2 (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-O/P (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-R.1 (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-R.2/T (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-S (in\u0026nbsp;U.S.\u0026nbsp;$)"],["\u003cstrong\u003eSpouse receiving Aid and Attendance\u003c/strong\u003e","201.41","201.41","201.41","201.41","201.41"]]}]}],"bordered":false},{"type":"paragraph--wysiwyg","id":"2eedf6aa-1c97-4b1e-a99b-4e5757b39a05","html":"\u003ch2 id=\"special-monthly-compensation-r\"\u003eSpecial monthly compensation rates for Veterans with dependents, including children\u003c/h2\u003e\u003cp\u003e\u003cstrong\u003eEffective December 1, 2025\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eLevels L through O\u003c/strong\u003e cover specific disabilities and situations.\u003c/p\u003e\u003cp\u003e\u003ca href=\"#how-we-assign-smc-levels-l-thr\"\u003eLearn how we assign SMC levels L through O\u003c/a\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eLevel R\u003c/strong\u003e may apply if you need daily help from another person for basic needs (like dressing, eating, and bathing).\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eLevel S\u003c/strong\u003e may apply if you can’t leave the house because of your service-connected disabilities.\u003c/p\u003e"},{"type":"paragraph--collapsible_panel","id":"5901ada9-187e-4277-bf3a-8d1c853908e5","entityId":187404,"paragraphs":[{"type":"paragraph--collapsible_panel_item","id":"389c2a0b-cbe8-4e3e-9bd1-c796442ba37a","entityId":191194,"title":"SMC-L through SMC-N","wysiwyg":"\u003cp\u003eStart with the \u003cstrong\u003eBasic SMC rates\u003c/strong\u003e table. Find the dependent status in the left column that best describes you. Then find your SMC letter designation in the top row. Your monthly basic rate is where your dependent status and SMC letter meet.\u003c/p\u003e\u003cp\u003eIf you have more than 1 child or your spouse receives\u0026nbsp;Aid and Attendance benefits,\u003cstrong\u003e\u0026nbsp;\u003c/strong\u003ebe sure to also check the\u0026nbsp;\u003cstrong\u003eAdded amounts\u003c/strong\u003e\u0026nbsp;table,\u0026nbsp;and add these to your amount from the\u0026nbsp;\u003cstrong\u003eBasic SMC rates\u003c/strong\u003e\u0026nbsp;table.\u003c/p\u003e\u003cp\u003e\u003ca href=\"/pension/aid-attendance-housebound\" data-entity-type=\"node\" data-entity-uuid=\"131d0c40-3680-4001-881e-e621eeae7337\" data-entity-substitution=\"canonical\" hreflang=\"en\" title=\"VA Aid and Attendance benefits and Housebound allowance\"\u003eLearn more about Aid and Attendance benefits\u003c/a\u003e\u003c/p\u003e","paragraphs":[{"type":"paragraph--table","id":"2d39695c-f99b-4836-99ab-02faa872c92e","entityId":192681,"title":"Basic SMC rates","data":[["Dependent status","SMC-L (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-L 1/2 (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-M (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-M 1/2 (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-N (in\u0026nbsp;U.S.\u0026nbsp;$)"],["\u003cstrong\u003eVeteran with 1 child\u003c/strong\u003e\u003cp\u003e(no spouse or parents)\u003c/p\u003e","5,047.68","5,300.85","5,555.40","5,926.85","6,299.49"],["\u003cstrong\u003eWith 1 child and spouse\u003c/strong\u003e\u003cp\u003e(no parents)\u003c/p\u003e","5,281.24","5,534.41","5,788.96","6,160.41","6,533.05"],["\u003cstrong\u003eWith 1 child, spouse, and 1 parent\u003c/strong\u003e\u003cp\u003e\u003c/p\u003e","5,457.48","5,710.65","5,965.20","6,336.65","6,709.29"],["\u003cstrong\u003eWith 1 child, spouse, and 2 parents\u003c/strong\u003e\u003cp\u003e\u003c/p\u003e","5,633.72","5,886.89","6,141.44","6,512.89","6,885.53"],["\u003cstrong\u003eWith 1 child and 1 parent\u003c/strong\u003e\u003cp\u003e(no spouse)\u003c/p\u003e","5,223.92","5,477.09","5,731.64","6,103.09","6,475.73"],["\u003cstrong\u003eWith 1 child and 2 parents\u003c/strong\u003e\u003cp\u003e(no spouse)\u003c/p\u003e","5,400.16","5,653.33","5,907.88","6,279.33","6,651.97"]]},{"type":"paragraph--table","id":"d3609357-817a-4d16-b7ba-777f10c08d59","entityId":192685,"title":"Added amounts","data":[["Dependent status","SMC-L (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-L 1/2 (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-M (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-M 1/2 (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-N (in\u0026nbsp;U.S.\u0026nbsp;$)"],["\u003cstrong\u003eEach additional child under age 18\u003c/strong\u003e","109.11","109.11","109.11","109.11","109.11"],["\u003cstrong\u003eEach additional child over age 18 in a qualifying school program\u003c/strong\u003e","352.45","352.45","352.45","352.45","352.45"],["\u003cstrong\u003eSpouse receiving Aid and Attendance\u003c/strong\u003e","201.41","201.41","201.41","201.41","201.41"]]}]},{"type":"paragraph--collapsible_panel_item","id":"ea6d3746-4040-49c9-904d-eca6eac45b83","entityId":191198,"title":"SMC-N 1/2 through SMC-S","wysiwyg":"\u003cp\u003eStart with the \u003cstrong\u003eBasic SMC rates\u003c/strong\u003e table. Find the dependent status in the left column that best describes you. Then find your SMC letter designation in the top row. Your monthly basic rate is where your dependent status and SMC letter meet.\u003c/p\u003e\u003cp\u003eIf you have more than 1 child or your spouse receives\u0026nbsp;Aid and Attendance benefits,\u003cstrong\u003e\u0026nbsp;\u003c/strong\u003ebe sure to also check the\u0026nbsp;\u003cstrong\u003eAdded amounts\u003c/strong\u003e\u0026nbsp;table,\u0026nbsp;and add these to your amount from the\u0026nbsp;\u003cstrong\u003eBasic SMC rates\u003c/strong\u003e\u0026nbsp;table.\u003c/p\u003e\u003cp\u003e\u003ca href=\"/pension/aid-attendance-housebound\" data-entity-type=\"node\" data-entity-uuid=\"131d0c40-3680-4001-881e-e621eeae7337\" data-entity-substitution=\"canonical\" hreflang=\"en\" title=\"VA Aid and Attendance benefits and Housebound allowance\"\u003eLearn more about Aid and Attendance benefits\u003c/a\u003e\u003c/p\u003e","paragraphs":[{"type":"paragraph--table","id":"d1114b1f-58fc-42cc-9426-ad0f1654a978","entityId":192689,"title":"Basic SMC rates","data":[["Dependent status","SMC-N 1/2 (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-O/P (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-R.1 (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-R.2/T (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-S (in\u0026nbsp;U.S.\u0026nbsp;$)"],["\u003cstrong\u003eVeteran with 1 child\u003c/strong\u003e\u003cp\u003e(no spouse or parents)\u003c/p\u003e","6,660.85","7,023.97","9,973.73","11,418.52","4,555.38"],["\u003cstrong\u003eWith 1 child and spouse\u003c/strong\u003e\u003cp\u003e(no parents)\u003c/p\u003e","6,894.41","7,257.53","10,207.29","11,652.08","4,788.94"],["\u003cstrong\u003eWith 1 child, spouse, and 1 parent\u003c/strong\u003e\u003cp\u003e\u003c/p\u003e","7,070.65","7,433.77","10,383.53","11,828.32","4,965.18"],["\u003cstrong\u003eWith 1 child, spouse, and 2 parents\u003c/strong\u003e\u003cp\u003e\u003c/p\u003e","7,246.89","7,610.01","10,559.77","12,004.56","5,141.42"],["\u003cstrong\u003eWith 1 child and 1 parent\u003c/strong\u003e\u003cp\u003e(no spouse)\u003c/p\u003e","6,837.09","7,200.21","10,149.97","11,594.76","4,731.62"],["\u003cstrong\u003eWith 1 child and 2 parents\u003c/strong\u003e\u003cp\u003e(no spouse)\u003c/p\u003e","7,013.33","7,376.45","10,326.21","11,771.00","4,907.86"]]},{"type":"paragraph--table","id":"1952272c-d639-4b80-baeb-654334f253ab","entityId":192693,"title":"Added amounts","data":[["Dependent status","SMC-N 1/2 (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-O/P (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-R.1 (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-R.2/T (in\u0026nbsp;U.S.\u0026nbsp;$)","SMC-S (in\u0026nbsp;U.S.\u0026nbsp;$)"],["\u003cstrong\u003eEach additional child under age 18\u003c/strong\u003e","109.11","109.11","109.11","109.11","109.11"],["\u003cstrong\u003eEach additional child over age 18 in a qualifying school program\u003c/strong\u003e","352.45","352.45","352.45","352.45","352.45"],["\u003cstrong\u003eSpouse receiving Aid and Attendance\u003c/strong\u003e","201.41","201.41","201.41","201.41","201.41"]]}]}],"bordered":false},{"type":"paragraph--wysiwyg","id":"947c28a9-a17f-407f-bf39-c0402d6d014b","html":"\u003cp\u003e\u003cstrong\u003eNote: \u003c/strong\u003eWe’re required by law to match the percentage of cost-of-living adjustments made to Social Security benefits. These adjustments help to make sure that the purchasing power of your benefits keeps up with inflation.\u003c/p\u003e\u003cp\u003e\u003ca href=\"https://www.ssa.gov/cola/\" hreflang=\"en\" target=\"_blank\"\u003eGet the latest cost-of-living adjustment (COLA) information on the Social Security Administration’s (SSA) website\u003c/a\u003e\u003c/p\u003e\u003ch2 id=\"how-to-use-the-tables-to-find-\"\u003eHow to use the tables to find your monthly payment\u003c/h2\u003e\u003ch3\u003eFind your basic rate\u003c/h3\u003e\u003cp\u003eGo to the SMC rate\u0026nbsp;that applies\u0026nbsp;to you. On the \u003cstrong\u003eBasic SMC\u003c/strong\u003e rates table, find the amount for your disability rating and SMC letter designation. This is your monthly basic rate.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eExample (Veteran with no children):\u003c/strong\u003e If you were a Veteran with a dependent spouse (no dependent parents or children), and you had an SMC-M designation, your monthly basic rate would be \u003cstrong\u003e$5,628.14 \u003c/strong\u003eeach month.\u003c/p\u003e\u003ch3\u003eFind your added amounts, if any apply\u003c/h3\u003e\u003cp\u003eIf your spouse receives Aid and Attendance benefits or you have more than 1 child, you may qualify for additional monthly payment amounts as listed in the \u003cstrong\u003eAdded amounts\u003c/strong\u003e table.\u003c/p\u003e\u003cp\u003e\u003ca href=\"/pension/aid-attendance-housebound\" data-entity-type=\"node\" data-entity-uuid=\"131d0c40-3680-4001-881e-e621eeae7337\" data-entity-substitution=\"canonical\" hreflang=\"en\" title=\"VA Aid and Attendance benefits and Housebound allowance\"\u003eLearn more about Aid and Attendance benefits\u003c/a\u003e\u003c/p\u003e\u003cp\u003eFirst, determine your basic rate.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eExample (Veteran with children):\u003c/strong\u003e If you’re a Veteran with an SMC-L designation, and you have 4 dependent children (1 child over age 18 in a qualifying school program and 3 children under age 18), and a dependent spouse, you would start with a basic SMC rate of \u003cstrong\u003e$5,281.24\u003c/strong\u003e for a Veteran with 1 child and spouse (no parents).\u003c/p\u003e\u003cp\u003eNext, look at the \u003cstrong\u003eAdded amounts\u003c/strong\u003e table. Find the amount for children under age 18 (\u003cstrong\u003e$109.11\u003c/strong\u003e).\u003c/p\u003e\u003cp\u003eSince your basic rate already provides payment for 1 child, you would add the rate of \u003cstrong\u003e$109.11\u0026nbsp;\u003c/strong\u003efor each additional child under age 18 (so \u003cstrong\u003e$109.11\u0026nbsp;\u003c/strong\u003ex 2).\u003c/p\u003e\u003cp\u003eThen, look for the rate for each additional child over 18 in a qualifying school program (\u003cstrong\u003e$352.45\u003c/strong\u003e).\u003c/p\u003e\u003cp\u003eIf your spouse receives Aid and Attendance, you would also add \u003cstrong\u003e$201.41\u0026nbsp;\u003c/strong\u003e(which is the added amount for a spouse receiving Aid and Attendance, for a Veteran with an SMC-L designation).\u003c/p\u003e\u003cp\u003eAdd these amounts to your basic rate to get your total monthly payment amount.\u003c/p\u003e\u003cp\u003eIn our example of a Veteran with an SMC-L designation, your total monthly payment amount would be:\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e$5,281.24 \u003c/strong\u003e(basic rate (1 spouse, 1 child)\u003cbr\u003e\u003cstrong\u003e+ 109.11 \u003c/strong\u003e(second child under 18)\u003cbr\u003e\u003cstrong\u003e+ 109.11 \u003c/strong\u003e(third child under 18)\u003cbr\u003e\u003cstrong\u003e+ 352.45\u0026nbsp;\u003c/strong\u003e(1 child over 18, in a qualifying school program)\u003cbr\u003e\u003cstrong\u003e+ 201.41 \u003c/strong\u003e(spouse who receives Aid and Attendance)\u003cbr\u003e\u003cstrong\u003eTotal: $6,053.32\u003c/strong\u003e\u003c/p\u003e\u003chr\u003e\u003ch2 id=\"how-we-assign-smc-levels-l-thr\"\u003eHow we assign SMC levels L through O\u003c/h2\u003e\u003cp\u003e\u003cstrong\u003eWe assign SMC levels based on very specific situations and combinations of situations, including:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eThe amputation of 1 or more limbs or extremities\u003c/li\u003e\u003cli\u003eThe loss of use of 1 or more limbs or extremities (meaning you have no effective function remaining)\u003c/li\u003e\u003cli\u003eThe physical loss of 1 or both eyes\u003c/li\u003e\u003cli\u003eThe loss of sight or total blindness in 1 or both eyes\u003c/li\u003e\u003cli\u003eBeing permanently bedridden (unable to get out of bed)\u003c/li\u003e\u003cli\u003eNeeding daily help with basic needs (like eating, dressing, and bathing), also called “Aid and Attendance”\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eSelect an SMC letter below to learn more about the specific situations and combinations of situations that fall within that designation.\u003c/p\u003e"},{"type":"paragraph--collapsible_panel","id":"ebf176d8-e43e-44b6-a580-3198330f8e1b","entityId":187412,"paragraphs":[{"type":"paragraph--collapsible_panel_item","id":"73b005d3-d41c-4e22-90b8-1d9cbfb1b19d","entityId":191202,"title":"SMC-L","wysiwyg":"\u003cp\u003e\u003cstrong\u003eYou may receive an SMC-L designation if any of these situations are true for you:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou’ve had both feet amputated, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 foot amputated, and have lost the use of the other foot, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 hand and 1 foot amputated, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 foot amputated, and have lost the use of 1 hand, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 hand amputated, and have lost the use of 1 foot\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eOr:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou’ve lost the use of both feet, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost the use of 1 hand and 1 foot\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eOr:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou’ve lost sight in both eyes (blindness), \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’re permanently bedridden, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou need daily help with basic needs (like eating, dressing, and bathing)\u003c/li\u003e\u003c/ul\u003e","paragraphs":[]},{"type":"paragraph--collapsible_panel_item","id":"d31dfcb7-323b-44fd-b0a3-46a22d89f3f1","entityId":191206,"title":"SMC-L 1/2","wysiwyg":"\u003cp\u003e\u003cstrong\u003eYou may receive an SMC-L 1/2 designation if any of these situations are true for you:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou’ve had 1 foot and the other knee amputated, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 foot amputated, and have lost the use of the other knee, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 foot and 1 elbow amputated, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 foot amputated, and have lost the use of 1 elbow, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 knee and 1 hand amputated, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 knee amputated, and have lost the use of 1 hand\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eOr:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou’ve lost the use of 1 foot, and have had the other knee amputated, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost the use of 1 foot, and have had 1 elbow amputated, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost the use of 1 foot and 1 elbow, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost the use of 1 knee, and have had 1 hand amputated, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost the use of 1 knee and 1 hand\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eOr:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou have blindness in 1 eye and total blindness in the other eye with only the ability to perceive light, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou have blindness in both eyes, and have lost the use of 1 foot (rated as less than 50% disabling), \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou have blindness in both eyes, and have total deafness in 1 ear\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eOr both of these are true:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou have a disability or situation listed in the SMC-L designation, \u003cstrong\u003eand\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou have 1 or more additional permanent disabilities rated as 50% or more disabling\u003c/li\u003e\u003c/ul\u003e","paragraphs":[]},{"type":"paragraph--collapsible_panel_item","id":"6ed92038-d672-4ef1-ae26-c95535b97c4a","entityId":191210,"title":"SMC-M","wysiwyg":"\u003cp\u003e\u003cstrong\u003eYou may receive an SMC-M designation if any of these situations are true for you:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou’ve had both hands amputated, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 hand amputated, and have lost the use of the other hand, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had both knees amputated, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 elbow and 1 knee amputated, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 foot amputated, and have lost the use of 1 arm at the shoulder, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 foot amputated, and have had 1 leg amputated so close to the hip that you can’t wear a prosthesis, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 foot amputated, and have had 1 arm amputated so close to the shoulder that you can’t wear a prosthesis, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 hand amputated, and have had 1 leg amputated so close to the hip that you can’t wear a prosthesis\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eOr:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou’ve lost the use of both hands, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost the use of both knees, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost the use of 1 elbow and 1 knee, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost the use of 1 foot and the use of 1 arm at the shoulder, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost the use of 1 foot, and have had 1 leg amputated so close to the hip that you can’t wear a prosthesis, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost the use of 1 foot, and have had 1 arm amputated so close to the shoulder that you can’t wear a prosthesis, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost the use of 1 hand, and have had 1 leg amputated so close to the hip that you can’t wear a prosthesis\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eOr you have blindness in 1 eye, and:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou’ve physically lost the other eye, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou have total blindness without the ability to perceive light in the other eye, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou have total blindness in the other eye with only the ability to perceive light, and have total deafness in 1 ear, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou have total blindness in the other eye with only the ability to perceive light, and have lost the use of 1 foot (rated as less than 50% disabling)\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eOr:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou have blindness in both eyes that’s considered total blindness, with only the ability to perceive light, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou have blindness in both eyes that requires you to have daily help with basic needs (like eating, dressing, and bathing)\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eOr you have blindness in both eyes, and:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou have deafness in both ears (rated as 30% or more disabling),\u003cstrong\u003e or\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 hand amputated, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost the use of 1 hand,\u003cstrong\u003e or\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 foot amputated, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost the use of 1 foot (rated as 50% or more disabling)\u003c/li\u003e\u003c/ul\u003e","paragraphs":[]},{"type":"paragraph--collapsible_panel_item","id":"64387090-4058-49e6-8dc9-448caa9449a7","entityId":191214,"title":"SMC-M 1/2","wysiwyg":"\u003cp\u003e\u003cstrong\u003eYou may receive an SMC-M 1/2 designation if any of these situations are true for you:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou’ve had\u0026nbsp;1 knee amputated, and have had 1 leg amputated so close to the hip that you can’t wear a prosthesis, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 knee amputated, and have had 1 arm amputated so close to the shoulder that you can’t wear a prosthesis, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 elbow amputated, and have had 1 leg amputated so close to the hip that you can’t wear a prosthesis, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 hand and 1 elbow amputated, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 hand amputated, and have lost the use of 1 elbow\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eOr:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou’ve lost the use of 1 knee, and have had 1 leg amputated so close to the hip that you can’t wear a prosthesis, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost the use of 1 knee, and have had 1 arm amputated so close to the shoulder that you can’t wear a prosthesis, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost the use of 1 elbow, and have had 1 leg amputated so close to the hip that you can’t wear a prosthesis, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost of use of 1 hand, and have had 1 elbow amputated, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost the use of 1 hand and 1 elbow\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eOr you have total blindness with only the ability to perceive light:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eIn 1 eye, and have physically lost the other eye, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eIn 1 eye, and have total blindness without the ability to perceive light in the other eye, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eIn both eyes, and have lost the use of 1 foot (rated as less than 50% disabling)\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eOr you have blindness in 1 eye, and:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou’ve physically lost the other eye, and have total deafness in 1 ear, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou have total blindness without the ability to perceive light in the other eye, and have total deafness in 1 ear, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou have total blindness with only the ability to perceive light in the other eye, and have deafness in both ears (rated as 30% or more disabling), \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou have total blindness with only the ability to perceive light in the other eye, and have had 1 foot amputated, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou have total blindness with only the ability to perceive light in the other eye, and have lost the use of 1 foot (rated as 50% or more disabling), \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou have total blindness with only the ability to perceive light in the other eye, and have had 1 hand amputated, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou have total blindness with only the ability to perceive light in the other eye, and have lost the use of 1 hand\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eOr:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou have blindness in both eyes and total deafness in 1 ear, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou have blindness in both eyes that requires you to have daily help with basic needs (like eating, bathing, and dressing), and have lost the use of 1 foot (rated as less than 50% disabling)\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eOr both of these are true:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou have a disability or situation listed in the SMC-M designation, \u003cstrong\u003eand\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou have 1 or more additional permanent disabilities rated as 50% or more disabling\u003c/li\u003e\u003c/ul\u003e","paragraphs":[]},{"type":"paragraph--collapsible_panel_item","id":"b616d1a7-b31b-4aac-9d16-f4b889eb9e7c","entityId":191218,"title":"SMC-N","wysiwyg":"\u003cp\u003e\u003cstrong\u003eYou may receive an SMC-N designation if any of these situations are true for you:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou’ve had both elbows amputated, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had both legs amputated so close to the hip that you can’t wear a prosthesis, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 arm and 1 leg amputated so close to the shoulder and hip that you can’t wear a prosthesis on either, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 hand amputated and the other arm amputated so close to the shoulder that you can’t wear a prosthesis\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eOr:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou’ve lost the use of both elbows, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost the use of 1 hand, and have had the other arm amputated so close to the shoulder that you can’t wear a prosthesis\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eOr:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou’ve physically lost both eyes, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou have total blindness without the ability to perceive light\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eOr you have total blindness with only the ability to perceive light in 1 eye, and:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou’ve physically lost the other eye, and have deafness in both ears (rated as 10% or 20% disabling), \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou have total blindness without the ability to perceive light in the other eye, and have deafness in both ears (rated as 10% or 20% disabling), \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve physically lost the other eye, and have lost the use of 1 foot (rated as less than 50% disabling), \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou have total blindness without the ability to perceive light in the other eye, and have lost the use of 1 foot (rated as less than 50% disabling)\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eOr you have total blindness with only the ability to perceive light in both eyes, and:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou have deafness in both ears (rated as 30% or more disabling), \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 hand amputated, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost the use of 1 foot, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost the use of 1 hand, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 foot amputated, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost the use of 1 foot (rated as 50% or more disabling)\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eOr you have blindness in 1 eye, and:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou’ve physically lost the other eye, and have deafness in both ears (rated as 30% or more disabling), \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou have total blindness without the ability to perceive light in the other eye, and have deafness in both ears (rated as 30% or more disabling)\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eOr you have blindness in both eyes that requires you to have daily help with basic needs (like dressing, eating, or bathing), and:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou have deafness in both ears (rated as 30% or more disabling), \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 hand amputated, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost the use of 1 hand, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 foot amputated, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost the use of 1 foot (rated as 50% disabling)\u003c/li\u003e\u003c/ul\u003e","paragraphs":[]},{"type":"paragraph--collapsible_panel_item","id":"dafc74f9-5ca5-480d-9a76-b17e600fa509","entityId":191222,"title":"SMC-N 1/2","wysiwyg":"\u003cp\u003e\u003cstrong\u003eYou may receive an SMC-N 1/2 designation if any of these situations are true for you:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou’ve had 1 elbow amputated, and have had 1 arm amputated so close to the shoulder that you can’t wear a prosthesis, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost the use of 1 elbow, and have had 1 arm amputated so close to the shoulder that you can’t wear a prosthesis, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve physically lost both eyes, and have lost the use of 1 foot (rated as less than 50% disabling), \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou have total blindness without the ability to see light, and have lost the use of 1 foot (rated as less than 50%)\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eOr you have total blindness with only the ability to perceive light in 1 eye, have physically lost the other eye, and:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou have deafness in both ears (rated as 30% or more disabling), \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 foot amputated, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost the use of 1 foot (rated as 50% or more disabling), \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 hand amputated, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost the use of 1 hand\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eOr you have total blindness with only the ability to perceive light in 1 eye and total blindness without the ability to perceive light in the other eye, and:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou have deafness in both ears (rated as 30% or more disabling), \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 foot amputated, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost the use of 1 foot (rated as 50% or more disabling), \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 hand amputated, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost the use of 1 hand\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eOr both of these are true:\u0026nbsp;\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou have a disability or situation listed in the SMC-N designation, \u003cstrong\u003eand\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou have 1 or more additional permanent disabilities rated as 50% or more disabling\u003c/li\u003e\u003c/ul\u003e","paragraphs":[]},{"type":"paragraph--collapsible_panel_item","id":"66c24764-1287-434a-a4e5-f061e37f19d6","entityId":191226,"title":"SMC-O","wysiwyg":"\u003cp\u003e\u003cstrong\u003eYou may receive an SMC-O designation if any of these situations are true for you:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou’ve had both arms amputated so close to the shoulder that you can’t wear a prosthesis, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou have complete paralysis of both legs that’s resulted in being unable to control your bladder and bowels\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eOr:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou have hearing loss in both ears (with at least 1 ear’s deafness caused by military service) that’s rated as 60% or more disabling, and you have blindness in both eyes, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou have hearing loss in both ears (with at least 1 ear’s deafness caused by military service) that’s rated as 40% or more disabling, and you have blindness in both eyes with only the ability to perceive light, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou have total deafness in 1 ear as well as blindness in both eyes with only the ability to perceive light\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eOr you have total blindness without the ability to see light, and:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou have deafness in both ears (rated as 30% or more disabling), \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 foot amputated, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost the use of 1 foot (rated as 50% or more disabling), \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 hand amputated, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost the use of 1 hand\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eOr you have physically lost both eyes, and:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eYou have deafness in both ears (rated as 30% or more disabling), \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 foot amputated, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost the use of 1 foot (rated as 50% or more disabling), \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve had 1 hand amputated, \u003cstrong\u003eor\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eYou’ve lost the use of 1 hand\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eOr you have 2 different disabilities or situations listed in the SMC-L, SMC-M, or SMC-N designations.\u003c/strong\u003e\u003c/p\u003e","paragraphs":[]}],"bordered":false},{"type":"paragraph--wysiwyg","id":"184c1603-038d-40df-8879-df37e90a3dac","html":"\u003ch2 id=\"past-rates\"\u003ePast rates\u003c/h2\u003e\u003cp\u003eReview special monthly compensation rates for past years.\u003c/p\u003e\u003cp\u003e\u003ca href=\"/disability/compensation-rates/special-monthly-compensation-rates/past-rates-2025\" data-entity-type=\"node\" data-entity-uuid=\"2f2641f8-235a-4dce-b4d8-18f2b62895bd\" data-entity-substitution=\"canonical\" title=\"Past rates: 2025 VA special monthly compensation rates\"\u003e2025 rates\u003c/a\u003e (effective December 1, 2024)\u003cbr\u003e\u003ca href=\"/disability/compensation-rates/special-monthly-compensation-rates/past-rates-2024\" data-entity-type=\"node\" data-entity-uuid=\"26ecb13d-275e-4808-a1b5-db3ade727034\" data-entity-substitution=\"canonical\" title=\"Past rates: 2024 VA special monthly compensation rates\"\u003e2024 rates\u003c/a\u003e (effective December 1, 2023)\u003cbr\u003e\u003ca href=\"/disability/compensation-rates/special-monthly-compensation-rates/past-rates-2023\" data-entity-type=\"node\" data-entity-uuid=\"aadc6f25-2e77-458d-bdaa-95a0938a3c02\" data-entity-substitution=\"canonical\" title=\"Past rates: 2023 VA special monthly compensation rates\"\u003e2023 rates\u003c/a\u003e (effective December 1, 2022)\u003c/p\u003e"}],"relatedLinks":{"type":"paragraph--list_of_link_teasers","id":"2e0751f3-cd28-420e-bd07-008366cb4e93","entityId":188734,"title":"Information to help you manage your benefits","linkTeasers":[{"type":"paragraph--link_teaser","id":"e3534961-7fe2-4f40-905c-ed08522b10c6","entityId":191230,"href":"/disability/how-to-file-claim/","label":"File for a VA disability increase","summary":"If your service-connected disability has gotten worse, find out how to file a claim to increase your disability rating."},{"type":"paragraph--link_teaser","id":"bb418ecb-7ec4-4a23-85fc-6b1b200c1dbc","entityId":191234,"href":"/manage-dependents/","label":"View or change dependents on your VA disability benefits","summary":"Find out how and when to add a dependent spouse, child, or parent to your VA disability benefits. Also learn how to remove a dependent from your benefits."},{"type":"paragraph--link_teaser","id":"d1425b2f-828f-4fc2-bb30-bc7d936c3082","entityId":191238,"href":"/change-direct-deposit/","label":"Change your VA direct deposit and contact information","summary":"Find out how to change your information online."},{"type":"paragraph--link_teaser","id":"25254f03-8bf8-4f77-989c-b10fb7819882","entityId":191242,"href":"/va-payment-history/","label":"View your disability payments history","summary":"Check the status of your VA disability and pension payments. You can also review certain survivor benefits."}]},"administration":{"entityId":69,"name":"Disability benefits hub"},"menu":{"rootPath":"/disability/compensation-rates/special-monthly-compensation-rates/","data":{"name":"Disability benefits","description":null,"links":[{"description":null,"expanded":false,"label":"Disability benefits","links":[